---
import type { CollectionEntry } from "astro:content";
import type { BlockProps } from "@/schemas/pages.ts";
import { blockComponents } from "@/blocks/index.ts";
import Layout from "@/layouts/Layout.astro";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const page = entry.data;
---

<Layout title={page.title} colorTheme={page.colorTheme}>
  {
    (page.blocks ?? []).map((block) => {
      const Block = blockComponents[block.type] as (
        props: BlockProps,
      ) => unknown;
      return Block ? <Block {...block} threadSpan={page.threadSpan} /> : null;
    })
  }
</Layout>
