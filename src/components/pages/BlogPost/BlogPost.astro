---
import { type CollectionEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import cn from 'clsx';
import Layout from '@/layouts/Layout.astro';
import styles from './BlogPost.module.css';

interface Props {
  entry: CollectionEntry<'blogPosts'>;
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);
const captionHtml = post.headerImageCaption
  ? await marked.parseInline(post.headerImageCaption)
  : null;
---

<Layout title={post.title}>
  <article>
    <h1 class="heading-l">{post.title}</h1>
    {post.subtitle && <p>{post.subtitle}</p>}
    {
      post.headerImage && (
        <figure>
          <Image
            src={post.headerImage}
            alt=""
            widths={[400, 800, post.headerImage.width]}
            sizes="(max-width: 800px) 100vw, 800px"
          />
          {captionHtml && <figcaption set:html={captionHtml} />}
        </figure>
      )
    }
    <p>
      {
        post.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
      {' · '}
      {post.author.join(', ')}
      {post.category && ` · ${post.category}`}
    </p>
    <div class="layout-grid gap-column-gap">
      <div class="row">
        <div class="col-span-3">span 4</div>
        <div class={cn('col-span-6', styles.content)}><Content /></div>
        <div class="col-span-3">span 4</div>
      </div>
    </div>
  </article>
</Layout>
