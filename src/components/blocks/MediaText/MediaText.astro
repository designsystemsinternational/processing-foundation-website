---
import cn from 'clsx';
import Image from '@/components/primitives/Image';
import Block, {
  type BlockComponentProps,
} from '@/components/composites/Block';
import TextStack from '@/components/composites/TextStack';
import type { MediaText } from '@/schemas/pages.ts';
import styles from './MediaText.module.css';

export type Props = BlockComponentProps<MediaText>;

const {
  heading,
  subheading,
  body,
  actions,
  variant,
  direction,
  images,
  ...block
} = Astro.props;
---

<Block {...block} inset>
  <div
    class={cn('row', 'container', styles.root)}
    data-variant={variant}
    data-direction={direction}
  >
    <TextStack
      className={styles.content}
      {heading}
      {subheading}
      {body}
      {actions}
      bodyColumns={variant === 'two-thirds'}
    />
    <div class={styles.images}>
      {
        images.length === 2
          ? images.map((item) => (
              <div class={styles.imageWrapper}>
                <Image {...item} />
              </div>
            ))
          : images.map((item) => <Image {...item} />)
      }
    </div>
  </div>
</Block>
