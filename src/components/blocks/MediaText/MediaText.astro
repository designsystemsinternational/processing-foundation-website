---
import cn from 'clsx';
import Media from '@/components/composites/Media';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import TextStack from '@/components/composites/TextStack';
import type { HeadingTag } from '@/lib/constants.ts';
import type { MediaText } from '@/schemas/pages.ts';
import { textLength } from '@/lib/utils.ts';
import styles from './MediaText.module.css';

// titleTag is not a block field: a CMS block keeps TextStack's default, while a
// page that renders this as its main content can ask for an h1.
export type Props = BlockComponentProps<MediaText> & { titleTag?: HeadingTag };

const TWO_COLUMN_MIN_CHARS = 300;

const {
  title,
  subtitle,
  body,
  actions,
  titleTag,
  variant = 'half',
  direction = 'left-to-right',
  media = [],
  ...block
}: Props = Astro.props;

const bodyColumns =
  variant === 'two-thirds' && textLength(body ?? '') >= TWO_COLUMN_MIN_CHARS;
---

<Block {...block} inset>
  <div
    class={cn('row', styles.root)}
    data-variant={variant}
    data-direction={direction}
  >
    <TextStack
      className={styles.content}
      {title}
      {subtitle}
      {body}
      {actions}
      {titleTag}
      {bodyColumns}
    />
    <div class={styles.images}>
      {
        media.length === 2
          ? media.map((item) => (
              <div class={styles.imageWrapper}>
                <Media {...item} />
              </div>
            ))
          : media.map((item) => <Media {...item} />)
      }
    </div>
  </div>
</Block>
