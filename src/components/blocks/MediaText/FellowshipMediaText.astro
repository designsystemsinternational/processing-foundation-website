---
import { getEntry } from 'astro:content';
import { renderMarkdown } from '@/lib/html.ts';
import type { BlockComponentProps } from '@/components/composites/Block';
import {
  fellowshipPath,
  fellowshipRefToId,
  fellowshipSubtitle,
  fellowshipTitle,
  imageIfSet,
} from '@/lib/utils.ts';
import type { FellowshipMediaText } from '@/schemas/pages.ts';
import MediaText from './MediaText.astro';

export type Props = BlockComponentProps<FellowshipMediaText>;

const {
  fellowship: ref,
  variant = 'two-thirds',
  direction = 'right-to-left',
  ...block
}: Props = Astro.props;

const entry = ref
  ? await getEntry('fellowships', fellowshipRefToId(ref))
  : undefined;
const image = imageIfSet(entry?.data.image);
---

{
  entry && (
    <MediaText
      {...block}
      {variant}
      {direction}
      title={fellowshipTitle(entry.data)}
      subtitle={fellowshipSubtitle(entry.data)}
      body={renderMarkdown(entry.body ?? '')}
      media={image ? [image] : []}
      actions={[
        {
          variant: 'primary',
          label: 'Read more',
          href: fellowshipPath(entry.id),
        },
      ]}
    />
  )
}
