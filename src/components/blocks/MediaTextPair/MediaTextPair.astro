---
import cn from 'clsx';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import TextStack from '@/components/composites/TextStack';
import Media from '@/components/composites/Media';
import type { MediaTextPair } from '@/schemas/pages.ts';
import styles from './MediaTextPair.module.css';

export type Props = BlockComponentProps<MediaTextPair>;

const {
  items,
  variant = 'default',
  mediaFirst,
  showDivider = false,
  ...block
}: Props = Astro.props;
---

<Block {...block} {showDivider}>
  <div
    class={cn('row', styles.root)}
    data-variant="intersection"
    data-gutter="solid"
    data-align="stretch"
    data-corner-top
    data-corner
    data-no-bleed
    data-pair-variant={variant}
    data-media-first={mediaFirst ? '' : undefined}
  >
    {
      items.map(({ media, ...text }) => (
        <div class={cn(styles.item, 'col-span-12', 'md:col-span-6')}>
          <div class={styles.inner}>
            <TextStack {...text} gap="xl" />
            <Media
              {...media}
              showPlaceholder={false}
              className={styles.media}
              widths={[400, 800]}
              sizes="(min-width: 56rem) 45vw, 100vw"
            />
          </div>
        </div>
      ))
    }
  </div>
</Block>
