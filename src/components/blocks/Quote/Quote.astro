---
import cn from 'clsx';
import { marked } from 'marked';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import type { Quote } from '@/schemas/pages';
import styles from './Quote.module.css';

export type Props = Quote & BlockProps;

const { quote, author = '', ...block } = Astro.props;

const quoteHtml = quote ? await marked.parse(quote) : null;
---

<Block {...block} inset={true}>
  <div class={cn('row', 'container', styles.gradients)}>
    <div class="md:col-start-1 md:col-span-2" data-filled="gradient"></div>
    <div class="md:col-start-11 md:col-span-2" data-filled="gradient"></div>
  </div>
  <div class="row">
    <div
      class={cn(
        'col-start-1 col-span-12 lg:col-start-4 lg:col-span-6 md:col-start-3 md:col-span-8',
        styles.quoteWrapper,
      )}
    >
      <blockquote
        class={cn('heading-xs', styles.blockquote)}
        set:html={quoteHtml}
      />
      {
        author && (
          <p class={cn('body-m', styles.author)}>
            — <cite class={styles.cite}>{author}</cite>
          </p>
        )
      }
    </div>
  </div>
</Block>
