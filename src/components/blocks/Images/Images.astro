---
import cn from 'clsx';
import Image from '@/components/primitives/Image';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import type { Images } from '@/schemas/pages.ts';
import styles from './Images.module.css';

export type Props = Omit<Images, 'images'> &
  BlockProps & {
    // `href` has no CMS field: it exists for the pages that build the list
    // themselves, like the showcase.
    images: (Images['images'][number] & { href?: string })[];
    // Lands on the grid row, so it can re-point --image-span per breakpoint.
    className?: string;
  };

const {
  images,
  variant = 'full',
  gradients,
  captionSize,
  className,
  ...block
} = Astro.props;
---

<Block {...block}>
  <div
    class={cn('row', 'container', styles.root, className)}
    data-variant={variant}
    data-gradients={gradients ? '' : undefined}
  >
    {
      images.map(({ href, ...item }) =>
        href ? (
          <a class={styles.link} href={href}>
            <Image {...item} captionSize={captionSize} />
          </a>
        ) : (
          <Image {...item} captionSize={captionSize} />
        ),
      )
    }
  </div>
</Block>
