---
import cn from 'clsx';
import Image from '@/components/primitives/Image';
import Block, {
  type BlockComponentProps,
} from '@/components/composites/Block';
import type { Images } from '@/schemas/pages.ts';
import styles from './Images.module.css';

export type Props = BlockComponentProps<
  Omit<Images, 'images'> & {
    // Some pages pass in a href on top of the image, like showcase
    images: (Images['images'][number] & { href?: string })[];
    // Often used to control --image-span per breakpoint.
    className?: string;
  }
>;

const {
  images,
  variant = 'full',
  gradients,
  captionSize,
  className,
  ...block
} = Astro.props;
---

<Block {...block}>
  <div
    class={cn('row', 'container', styles.root, className)}
    data-variant={variant}
    data-gradients={gradients ? '' : undefined}
  >
    {
      images.map(({ href, ...item }) =>
        href ? (
          <a class={styles.link} href={href}>
            <Image {...item} captionSize={captionSize} />
          </a>
        ) : (
          <Image {...item} captionSize={captionSize} />
        ),
      )
    }
  </div>
</Block>
