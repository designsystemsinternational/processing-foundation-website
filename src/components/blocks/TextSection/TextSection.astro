---
import cn from 'clsx';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import TextStack from '@/components/composites/TextStack';
import type { TextSection } from '@/schemas/pages.ts';
import styles from './TextSection.module.css';

export type Props = BlockComponentProps<TextSection>;

const {
  title,
  titleSize,
  subtitle,
  subtitleSize,
  body,
  actions = [],
  variant = 'default',
  ...block
}: Props = Astro.props;

const hasTitle = Boolean(title || subtitle);
const hasBody = Boolean(body) || actions.length > 0;

const weaveColumns = [1, 2, 3];
const sideStart = {
  placement: 'sm:col-start-1 sm:col-span-1 lg:col-start-1 lg:col-span-3',
  keeps: 3,
};
const sideEnd = {
  placement: 'sm:col-start-6 sm:col-span-1 lg:col-start-10 lg:col-span-3',
  keeps: 2,
};

const banners = {
  'weave-banner': {
    sides: [
      { ...sideStart, rows: [[1, 3], [2], [3]] },
      { ...sideEnd, rows: [[1, 3], [2], [3]] },
    ],
  },
  'intersection-banner': {
    sides: [
      { ...sideStart, rows: [[], [2], [3], [2], []] },
      { ...sideEnd, rows: [[], [3], [2], [3], []] },
    ],
  },
};

const banner =
  banners[variant as keyof typeof banners] ?? banners['weave-banner'];
const isWeave = variant === 'weave-banner';

const bannerColumns =
  'sm:col-start-2 sm:col-span-4 lg:col-start-4 lg:col-span-6';
---

<Block {...block} inset>
  {
    variant === 'weave-banner' || variant === 'intersection-banner' ? (
      <div
        class={cn('row', styles.banner)}
        style={{ '--banner-rows': banner.sides[0].rows.length }}
      >
        {banner.sides.map(({ placement, keeps, rows }) => (
          <div
            class={cn('row', styles.weaveSide, placement)}
            data-size="none"
            data-corner-top
            data-corner-size="xs"
            data-no-bleed
            aria-hidden="true"
          >
            {rows.map((picked) =>
              weaveColumns.map((column) => (
                <div
                  class={cn(
                    'col-span-1',
                    column === keeps
                      ? `col-start-1 lg:col-start-${column}`
                      : `hidden lg:block lg:col-start-${column}`,
                    !isWeave && picked.includes(column) && styles.accentMark,
                  )}
                  data-filled={
                    isWeave && picked.includes(column) ? 'gradient' : undefined
                  }
                />
              )),
            )}
          </div>
        ))}
        <TextStack
          className={cn(bannerColumns, styles.bannerText)}
          gap="2xl"
          {title}
          {titleSize}
          {subtitle}
          {subtitleSize}
          {body}
          {actions}
        />
      </div>
    ) : (
      <div class={cn('row', styles.root)} data-variant={variant}>
        {hasTitle && (
          <TextStack
            className={styles.header}
            {title}
            {titleSize}
            {subtitle}
            {subtitleSize}
          />
        )}
        {hasBody && <TextStack className={styles.body} {body} {actions} />}
      </div>
    )
  }
</Block>
