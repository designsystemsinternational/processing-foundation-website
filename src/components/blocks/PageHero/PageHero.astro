---
import cn from 'clsx';
import { marked } from 'marked';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import Divider from '@/components/primitives/Divider';
import Image from '@/components/primitives/Image';
import type { PageHero } from '@/schemas/pages.ts';
import styles from './PageHero.module.css';
import type { Spacing } from '@/lib/constants';

export type Props = BlockComponentProps<PageHero>;

const {
  eyebrow,
  title,
  subtitle,
  text,
  image,
  variant = 'default',
  ...block
}: Props = Astro.props;

const textHtml = text ? await marked.parse(text) : null;
const hasAccent = variant === 'accent';

const spacing: Spacing = block.spacing ?? 'm';
---

<Block {...block} {spacing} inset dividerVariant="intersection">
  <div class={styles.root} data-variant={variant}>
    <header class={styles.header}>
      {eyebrow && <p class="eyebrow mb-l">{eyebrow}</p>}
      <h1 class="heading-l">{title}</h1>
      {
        subtitle && (
          <p class={cn('heading-s', 'text-secondary', 'mt-s')}>{subtitle}</p>
        )
      }
    </header>
    {
      hasAccent && (
        <Divider
          className={styles.divider}
          threadSpan={block.threadSpan}
          size={block.dividerSize}
          variant="intersection"
        />
      )
    }
    {textHtml && <div class={cn('body-l', styles.text)} set:html={textHtml} />}
    {
      image?.src ? (
        <>
          <div class={styles.image}>
            <Image {...image} src={image.src} />
          </div>
          {hasAccent && <div class={styles.headerAccent} />}
        </>
      ) : (
        hasAccent && (
          <>
            <div class={styles.textAccent} />
            <div class={styles.imageAccentTall} />
            <div class={styles.imageAccentShort} />
          </>
        )
      )
    }
  </div>
</Block>
