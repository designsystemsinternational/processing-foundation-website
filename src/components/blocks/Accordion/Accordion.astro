---
import cn from 'clsx';

import Block, { type BlockComponentProps } from '@/components/composites/Block';
import type { Accordion } from '@/schemas/pages.ts';

import styles from './Accordion.module.css';

export type Props = BlockComponentProps<Accordion>;

const { items = [], openMode = 'closed', ...block } = Astro.props;

const collapsible = openMode !== 'all';
const isOpen = (index: number) =>
  openMode === 'all' || (openMode === 'first' && index === 0);

const id = crypto.randomUUID();
---

<Block {...block} inset>
  <div class="row">
    <div class={cn('col-span-12 md:col-start-7 md:col-span-6', styles.panel)}>
      <ul class={styles.list} data-accordion={collapsible ? '' : undefined}>
        {
          items.map((item, index) => {
            const bodyId = `accordion-${id}-${index}`;
            const title = <span class="body-s bold">{item.title}</span>;
            const body = (
              <div
                class={cn('body-s markdown', styles.body)}
                set:html={item.body}
              />
            );

            return (
              <li class={cn(styles.item, 'text-primary')}>
                {collapsible ? (
                  <button
                    type="button"
                    class={cn(styles.header, styles.toggleHeader)}
                    data-accordion-toggle
                    aria-expanded={isOpen(index)}
                    aria-controls={bodyId}
                  >
                    {title}
                    <span class={styles.toggle} aria-hidden="true" />
                  </button>
                ) : (
                  <div class={styles.header}>{title}</div>
                )}

                {collapsible ? (
                  <div
                    id={bodyId}
                    class={styles.collapse}
                    data-open={String(isOpen(index))}
                  >
                    <div class={styles.collapseInner}>{body}</div>
                  </div>
                ) : (
                  body
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</Block>

<script>
  // Astro leaves this script's TypeScript to esbuild, but Storybook re-injects
  // it untransformed — any annotation in here is a SyntaxError in the browser.
  document.querySelectorAll('[data-accordion]').forEach((accordion) => {
    const toggles = Array.from(
      accordion.querySelectorAll('[data-accordion-toggle]'),
    );

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const opening = toggle.getAttribute('aria-expanded') !== 'true';

        toggles.forEach((other) => {
          const isOpen = other === toggle && opening;
          other.setAttribute('aria-expanded', String(isOpen));

          const id = other.getAttribute('aria-controls');
          const collapse = id ? document.getElementById(id) : null;
          collapse?.setAttribute('data-open', String(isOpen));
        });
      });
    });
  });
</script>
