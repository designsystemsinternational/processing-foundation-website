---
import cn from 'clsx';

import Divider from '@/components/primitives/Divider';
import Image from '@/components/primitives/Image';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Tag from '@/components/primitives/Tag';

import Block, { type Props as BlockProps } from '@/components/composites/Block';

import type {
  HighlightsGridItemColumns,
  HighlightsGridVariant,
} from '@/lib/constants.ts';
import type { HighlightsGrid } from '@/schemas/pages.ts';

import styles from './HighlightsGrid.module.css';

export type Props = HighlightsGrid & BlockProps;

const IMAGE_WIDTHS = [320, 480, 640, 960];

const GRID_COLUMNS = 12;

// In `offset` a cell holds the card plus an equally wide empty slot, so it spans
// twice `itemColumns`. Every class here is safelisted in uno.config.js.
const CELL_SPANS: Record<
  HighlightsGridVariant,
  Record<HighlightsGridItemColumns, string>
> = {
  offset: {
    2: 'col-span-12 md:col-span-4',
    3: 'col-span-12 md:col-span-6',
    6: 'col-span-12',
  },
  full: {
    2: 'col-span-6 sm:col-span-4 md:col-span-2',
    3: 'col-span-12 sm:col-span-6 md:col-span-3',
    6: 'col-span-12 md:col-span-6',
  },
};

const IMAGE_SIZES: Record<
  HighlightsGridVariant,
  Record<HighlightsGridItemColumns, string>
> = {
  offset: {
    2: '(min-width: 56rem) 17vw, 50vw',
    3: '(min-width: 56rem) 25vw, 50vw',
    6: '50vw',
  },
  full: {
    2: '(min-width: 56rem) 17vw, (min-width: 42rem) 33vw, 50vw',
    3: '(min-width: 56rem) 25vw, (min-width: 42rem) 50vw, 100vw',
    6: '(min-width: 56rem) 50vw, 100vw',
  },
};

const {
  highlights = [],
  variant = 'offset',
  itemColumns = 3,
  ...block
} = Astro.props;

const cardsPerRow =
  variant === 'offset'
    ? GRID_COLUMNS / (itemColumns * 2)
    : GRID_COLUMNS / itemColumns;

const rows = Array.from(
  { length: Math.ceil(highlights.length / cardsPerRow) },
  (_, row) => highlights.slice(row * cardsPerRow, (row + 1) * cardsPerRow),
);
---

<Block {...block} inset>
  <div class="layout-grid">
    {
      rows.map((row, rowIndex) => (
        <Fragment>
          <Divider
            size={block.dividerSize}
            threadSpan={block.threadSpan}
            variant="intersection"
          />
          <div
            class={cn('row', styles.row)}
            data-align="stretch"
            data-item-columns={itemColumns}
          >
            {row.map((highlight, index) => {
              const Card = highlight.link ? 'a' : 'div';
              return (
                <div
                  class={cn(CELL_SPANS[variant][itemColumns], styles.pair)}
                  style={`--i: ${rowIndex * cardsPerRow + index}`}
                >
                  <Card
                    href={highlight.link}
                    class="flex flex-col gap-s bg-default"
                  >
                    <div class={styles.photo}>
                      {highlight.image ? (
                        <Image
                          src={highlight.image}
                          alt={highlight.imageAlt ?? ''}
                          widths={IMAGE_WIDTHS}
                          sizes={IMAGE_SIZES[variant][itemColumns]}
                        />
                      ) : (
                        <ImagePlaceholder />
                      )}
                    </div>
                    <div class="flex flex-col flex-grow justify-between gap-m px-l pb-l">
                      <div class={cn('flex flex-col', styles.text)}>
                        {highlight.eyebrow && (
                          <p class="body-2xs text-secondary">
                            {highlight.eyebrow}
                          </p>
                        )}
                        <p class={cn('heading-2xs', styles.title)}>
                          {highlight.title}
                        </p>
                      </div>
                      {highlight.categories &&
                        highlight.categories.length > 0 && (
                          <div class={cn('flex flex-wrap', styles.tags)}>
                            {highlight.categories.map((category) => (
                              <Tag label={category} size="small" />
                            ))}
                          </div>
                        )}
                    </div>
                  </Card>

                  {variant === 'offset' && (
                    <div
                      class={cn('hidden sm:block bg-default', styles.slot)}
                      data-filled="gradient"
                    />
                  )}
                </div>
              );
            })}
          </div>
        </Fragment>
      ))
    }
  </div>
</Block>
