---
import cn from 'clsx';
import { marked } from 'marked';

import Divider from '@/components/primitives/Divider';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import { blockDefaults } from '@/lib/constants.ts';
import type { StatementList } from '@/schemas/pages.ts';

import styles from './StatementList.module.css';

export type Props = StatementList & BlockProps;

const { statements = [], statementSpacing, ...block }: Props = Astro.props;
const spacing = statementSpacing ?? block.spacing;
// data-size on a .row, unlike Block and Divider, has no fallback of its own:
// with the attribute absent the row keeps its own --divider-size of `m`.
const dividerSize = block.dividerSize ?? blockDefaults.dividerSize;

const statementsHtml = await Promise.all(
  statements.map((statement) => marked.parse(statement.description)),
);

const cellsBefore = (index: number) => Math.max(colStart(index) - 1, 0);
const colStart = (index: number) => 4 - Math.abs((index % 4) - 2);
const cellsAfter = (index: number) => 5 - colStart(index);
---

<Block {...block} inset>
  <div class={styles.root} data-spacing={spacing}>
    {
      statements.map((statement, index) => (
        <div>
          <Divider size={block.dividerSize} threadSpan={block.threadSpan} />
          <div class="layout-grid">
            <div
              class={cn('row', styles.row)}
              data-size={dividerSize}
            >
              <div
                class={cn(
                  'col-span-2 sm:hidden',
                  index % 2 === 1 && 'col-start-3',
                  styles.gradient,
                )}
                data-filled="gradient"
              />

              {Array.from({ length: cellsBefore(index) }).map((_, j) => (
                <div
                  class={cn(
                    'col-span-2 hidden',
                    j === 0 ? 'md:block' : 'sm:block',
                  )}
                  data-filled={
                    j + 1 === colStart(index) - 1 ? 'gradient' : null
                  }
                />
              ))}

              <div class={cn('col-span-4 flex flex-col', styles.statement)}>
                <h3 class="heading-s text-primary">{statement.title}</h3>
                <div
                  class="body-m text-primary markdown"
                  set:html={statementsHtml[index]}
                />
              </div>

              {Array.from({ length: cellsAfter(index) }).map((_, j) => (
                <div
                  class={cn(
                    'col-span-2 hidden',
                    j === cellsAfter(index) - 1 ? 'md:block' : 'sm:block',
                  )}
                  data-filled={j === 0 ? 'gradient' : null}
                />
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Block>
