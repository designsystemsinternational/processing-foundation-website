---
import { Image } from 'astro:assets';
import cn from 'clsx';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import type { FeaturedBlogPost } from '@/schemas/pages.ts';
import styles from './FeaturedBlogPost.module.css';

export type Props = FeaturedBlogPost & BlockProps;

const IMAGE_WIDTH = 1600;
const IMAGE_HEIGHT = IMAGE_WIDTH * 0.6;

const {
  image,
  imageAlt,
  imagePosition,
  title,
  text,
  link,
  author,
  date,
  readTime,
  ...block
} = Astro.props;

const meta = [
  author,
  date &&
    new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }),
  readTime && `${readTime} min read`,
].filter(Boolean);
---

<Block {...block} inset>
  <div class={cn('row', 'container', styles.root)}>
    {
      image && (
        <div class={styles.image}>
          <Image
            src={image}
            alt={imageAlt ?? ''}
            width={IMAGE_WIDTH}
            height={IMAGE_HEIGHT}
            widths={[640, 1080, IMAGE_WIDTH]}
            sizes="(min-width: 56rem) 50vw, 100vw"
            fit="cover"
            position={imagePosition}
          />
        </div>
      )
    }
    <article class={styles.content}>
      <h2 class="heading-s">
        {
          link ? (
            <a class={styles.link} href={link}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h2>
      {text && <p class={cn('body-m', styles.text)}>{text}</p>}
      {
        meta.length > 0 && (
          <p class={cn('body-xs', 'text-secondary', styles.meta)}>
            {meta.map((item) => (
              <span>{item}</span>
            ))}
          </p>
        )
      }
    </article>
  </div>
</Block>
