---
import { Image } from 'astro:assets';
import cn from 'clsx';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import type { FeaturedBlogPost } from '@/schemas/pages.ts';
import styles from './FeaturedBlogPost.module.css';
import {
  dateLabel,
  dateIso,
  readTimeDatetime,
  readTimeLabel,
} from '@/lib/utils.ts';

export type Props = BlockComponentProps<FeaturedBlogPost>;

const IMAGE_WIDTH = 1600;
const IMAGE_HEIGHT = IMAGE_WIDTH * 0.6;

const {
  image,
  imageAlt,
  imagePosition,
  title,
  text,
  link,
  author,
  date,
  readTime,
  ...block
}: Props = Astro.props;
---

<Block {...block} inset>
  <div class={cn('row', styles.root)}>
    {
      image && (
        <div class={styles.image}>
          <Image
            src={image}
            alt={imageAlt ?? ''}
            width={IMAGE_WIDTH}
            height={IMAGE_HEIGHT}
            widths={[640, 1080, IMAGE_WIDTH]}
            sizes="(min-width: 56rem) 50vw, 100vw"
            fit="cover"
            position={imagePosition ?? 'center'}
          />
        </div>
      )
    }
    <article class={styles.content}>
      <h2 class="heading-s">
        {
          link ? (
            <a class={styles.link} href={link}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h2>
      {text && <p class="body-m mt-s">{text}</p>}
      <div class="mt-xl">
        {author && <p class="body-m  text-secondary">by {author}</p>}
        {
          date && readTime && (
            <p class="body-xs  mt-xs text-secondary">
              {<time datetime={dateIso(date)}>{dateLabel(date)}</time>} /{' '}
              <time datetime={readTimeDatetime(readTime)}>
                {readTimeLabel(readTime)}
              </time>
            </p>
          )
        }
      </div>
    </article>
  </div>
</Block>
