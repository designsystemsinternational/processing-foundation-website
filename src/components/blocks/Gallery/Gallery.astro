---
import cn from 'clsx';
import Media from '@/components/composites/Media';
import { ArrowIcon } from '@/components/primitives/Icons';
import Block, { type BlockComponentProps } from '@/components/composites/Block';
import type { Gallery } from '@/schemas/pages.ts';
import styles from './Gallery.module.css';

export type Props = BlockComponentProps<
  Omit<Gallery, 'media'> & {
    // Some pages pass in a href on top of the item, like showcase
    media: (Gallery['media'][number] & { href?: string })[];
    // Overrides the --image-span ladder derived from the item count.
    className?: string;
  }
>;

const {
  media = [],
  variant = 'full',
  gradients,
  captionSize,
  className,
  ...block
}: Props = Astro.props;

const fullWidthSpans = { base: 12, sm: 12, md: 12, lg: 12 };

// Every step down divides the item count evenly, so no row ends with a single
// orphan item.
const spansByItemCount = [
  fullWidthSpans,
  { base: 12, sm: 6, md: 6, lg: 6 },
  { base: 12, sm: 4, md: 4, lg: 4 },
  { base: 12, sm: 6, md: 3, lg: 3 },
  { base: 12, sm: 6, md: 4, lg: 4 },
  { base: 12, sm: 6, md: 4, lg: 2 },
];

const spans =
  spansByItemCount[Math.min(media.length, spansByItemCount.length) - 1] ??
  fullWidthSpans;

const spanStyle = Object.entries(spans)
  .map(([breakpoint, span]) => `--image-span-${breakpoint}:${span}`)
  .join(';');

const slides = media.map(({ href: _href, ...item }) => item);
const hasArrows = slides.length > 1;
---

<Block {...block}>
  {
    media.length > 0 &&
      (variant === 'carousel' ? (
        <div
          class={cn('row', styles.carousel, className)}
          data-align="stretch"
          data-carousel
        >
          <div class={cn(styles.panel, styles.panelPrevious, 'sm:col-span-2')}>
            <span class={styles.panelFill} data-filled="gradient" />
            {hasArrows && (
              <button
                class={styles.arrow}
                type="button"
                aria-label="Previous item"
                data-carousel-previous
              >
                <ArrowIcon direction="up" size={28} />
              </button>
            )}
          </div>

          <div
            class={cn(styles.viewport, 'col-span-12', 'sm:col-span-8')}
            data-carousel-viewport
          >
            <ul class={styles.track} data-carousel-track>
              {slides.map((item, index) => (
                <li
                  class={styles.slide}
                  data-carousel-slide
                  data-active={String(index === 0)}
                  inert={index === 0 ? undefined : true}
                >
                  <Media {...item} captionSize={captionSize} />
                </li>
              ))}
            </ul>
          </div>

          <div class={cn(styles.panel, styles.panelNext, 'sm:col-span-2')}>
            <span class={styles.panelFill} data-filled="gradient" />
            {hasArrows && (
              <button
                class={styles.arrow}
                type="button"
                aria-label="Next item"
                data-carousel-next
              >
                <ArrowIcon direction="down" size={28} />
              </button>
            )}
          </div>
        </div>
      ) : (
        <div
          class={cn('row', styles.root, className)}
          data-variant={variant}
          data-gutter={gradients ? 'gradient' : undefined}
          data-align={gradients ? 'stretch' : undefined}
          style={spanStyle}
        >
          {media.map(({ href, ...item }) =>
            href ? (
              <a class={styles.link} href={href}>
                <Media {...item} captionSize={captionSize} />
              </a>
            ) : (
              <Media {...item} captionSize={captionSize} />
            ),
          )}
        </div>
      ))
  }
</Block>

<script>
  import { initCarousel } from './carousel.ts';

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach(initCarousel);
</script>
