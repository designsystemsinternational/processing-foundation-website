---
import cn from 'clsx';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import type { Numbers } from '@/schemas/pages.ts';
import styles from './Numbers.module.css';

export type Props = Numbers & BlockProps;

const { heading, numbers, ...block } = Astro.props;
const numberOfItems = numbers.length;
---

<Block {...block} inset>
  <div class={cn('row', styles.heading)}>
    <h4 class="heading-s col-span-6">{heading}</h4>
  </div>
  <div
    class={cn('row', styles.numbers)}
    data-gutter="gradient"
    data-size="none"
  >
    {
      numbers.map((n) => (
        <>
          <div class={styles.numberWrapper} data-n={numberOfItems}>
            <span class={cn('heading-xl', styles.number)}>
              {n.n}
              {n.suffix ?? ''}
            </span>
            <span class={cn('body-l', styles.description)}>
              {n.description}
            </span>
            {n.subDescription && (
              <span class={cn('body-m', styles.subDescription)}>
                {n.subDescription}
              </span>
            )}
            {n.timeSpan && (
              <span class={cn('body-m text-secondary', styles.timeSpan)}>
                {n.timeSpan}
              </span>
            )}
          </div>
        </>
      ))
    }
  </div>
</Block>
