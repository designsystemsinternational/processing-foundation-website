---
import cn from 'clsx';
import Block, { type Props as BlockProps } from '@/components/composites/Block';
import ButtonGroup from '@/components/composites/ButtonGroup/ButtonGroup.astro';
import Button from '@/components/primitives/Button/Button.astro';
import type { Numbers } from '@/schemas/pages.ts';
import styles from './Numbers.module.css';

export type Props = Numbers & BlockProps;

const { title, numbers = [], actions = [], ...block } = Astro.props;
const numberOfItems = numbers.length;
---

<Block {...block} inset>
  <div class="container">
    <div class={cn('row', styles.title)}>
      <h4 class="heading-s col-span-12 md:col-span-6">{title}</h4>
      <div class="mt-l">
        {
          actions?.length > 0 && (
            <ButtonGroup>
              {actions.map((a) => (
                <Button {...a} />
              ))}
            </ButtonGroup>
          )
        }
      </div>
    </div>
    <div
      class={cn('row', styles.numbers)}
      data-gutter="gradient"
      data-size="none"
      data-corner
      data-corner-size="m"
      data-no-bleed
    >
      {
        numbers.map((n) => (
          <>
            <div class={styles.numberWrapper} data-n={numberOfItems}>
              <span class={cn('heading-2xl', styles.number)}>
                {n.n}
                {n.suffix ?? ''}
              </span>
              <span class={cn('body-m', styles.description)}>
                {n.description}
              </span>
              {n.subDescription && (
                <span class={cn('body-m', styles.subDescription)}>
                  {n.subDescription}
                </span>
              )}
              {n.timeSpan && (
                <span class={cn('body-s text-secondary', styles.timeSpan)}>
                  {n.timeSpan}
                </span>
              )}
            </div>
          </>
        ))
      }
    </div>
  </div>
</Block>
