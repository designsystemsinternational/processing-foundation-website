---
import type { Page } from "../schemas/pages.ts";
import type { ThreadSpan } from "../lib/constants.ts";
import { blockComponents } from "../blocks/index.ts";
import Layout from "../layouts/Layout.astro";

interface Props {
  page: Page;
  baseHref?: string;
}

const { page } = Astro.props;
---

<Layout title={page.title} colorTheme={page.colorTheme}>
  {
    (page.blocks ?? []).map((block) => {
      const Block = blockComponents[block.type] as (
        props: typeof block & { threadSpan?: ThreadSpan },
      ) => unknown;
      return Block ? <Block {...block} threadSpan={page.threadSpan} /> : null;
    })
  }
</Layout>
