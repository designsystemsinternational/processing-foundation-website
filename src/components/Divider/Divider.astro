---
import cn from 'clsx';
import styles from './Divider.module.css';

export interface Props {
  threadSize?: 1 | 2 | 3 | 4;
  dividerSize?: 's' | 'm' | 'l' | 'xl';
}

const { threadSize = 1, dividerSize = 's' } = Astro.props;
const numThreads = 12 / threadSize;
---

<div class={cn('layout-grid', styles.root)} data-size={dividerSize}>
  <div class="row">
    {
      [...Array(numThreads)].map((_, i) => (
        <div class={cn(`col-span-${threadSize}`, styles.thread)} />
      ))
    }
  </div>
</div>
