---
import cn from 'clsx';

import Button from '@/components/primitives/Button';
import Divider from '@/components/primitives/Divider';
import Image from '@/components/primitives/Image/Image.astro';
import NewsletterSignup from '@/components/composites/NewsletterSignup';

import PFLogo from '@/assets/media/ProcessingFoundation-logo.svg';
import CandidBadge from '@/assets/media/CandidBadge.svg';
import CharityNavigatorBadge from '@/assets/media/charitynavigator.webp';

import type { Footer } from '@/schemas/footer';

import type { ThreadSpan } from '@/lib/constants.ts';

import styles from './Footer.module.css';
import { marked } from 'marked';

export interface Props extends Footer {
  threadSpan?: ThreadSpan;
}

const {
  heading,
  support,
  socialLinks = [],
  newsletter,
  copyright,
  legalLinks = [],
  threadSpan,
}: Props = Astro.props;

// Inlined rather than <img src>, so the icon's `fill="currentColor"` picks up
// the active colour theme.
const icons = import.meta.glob<string>('/src/assets/social/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const iconFor = (platform: string) =>
  icons[`/src/assets/social/${platform}.svg`];

const copyrightHtml = copyright ? marked.parse(copyright) : null;
---

<footer class={cn('mt-section-gap', styles.root)}>
  <Divider size="s" threadSpan={threadSpan} />

  <div class={cn('row', styles.mobile)}>
    <div class="mt-l flex flex-col col-span-12 gap-m">
      <div class={cn('flex items-center ', styles.logo)}>
        <PFLogo />
      </div>

      <div class="flex flex-col gap-l justify-between">
        {heading && <p class="body-s text-secondary">{heading}</p>}
      </div>
    </div>
    <div class={cn('flex', styles.badges)}>
      <a
        href="https://app.candid.org/profile/9294007/processing-foundation-46-0830259"
        ><CandidBadge /></a
      >
      <a href="https://www.charitynavigator.org/ein/460830259"
        ><Image src={CharityNavigatorBadge} /></a
      >
    </div>

    {newsletter && <NewsletterSignup {...newsletter} size="small" />}

    {
      socialLinks.length > 0 && (
        <div class="flex items-center gap-m">
          {socialLinks.map((s) => {
            return (
              <a class="link" href={s.path} aria-label={s.title}>
                {s.title}
              </a>
            );
          })}
        </div>
      )
    }

    <div class={cn('flex flex-col', styles.legal)}>
      {
        copyright && (
          <div
            class="body-2xs text-secondary markdown"
            set:html={copyrightHtml}
          />
        )
      }

      {
        legalLinks.length > 0 && (
          <div class="flex gap-l">
            {legalLinks.map((l) => (
              <a class="body-2xs link" href={l.path}>
                {l.title}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <div class={cn('row', styles.desktop)}>
    <div
      class={cn(
        'col-start-1 col-span-4 flex items-center justify-center',
        styles.logo,
      )}
    >
      <PFLogo />
    </div>

    <div
      class={cn(
        'flex col-start-8 col-span-5 xl:col-start-9 xl:col-span-4',
        styles.badges,
      )}
    >
      <a
        href="https://app.candid.org/profile/9294007/processing-foundation-46-0830259"
        ><CandidBadge /></a
      >
      <a href="https://www.charitynavigator.org/ein/460830259"
        ><Image src={CharityNavigatorBadge} /></a
      >
    </div>

    <div
      class={cn(
        'col-start-1 col-span-4 flex flex-col gap-l justify-between',
        styles.main,
      )}
    >
      <div class={cn('flex flex-col gap-m', styles.headingWrapper)}>
        {heading && <p class="heading-2xs text-secondary">{heading}</p>}

        {support && <Button label={support.title} href={support.path} />}
      </div>

      <div class={cn('flex flex-col', styles.legal)}>
        {
          copyright && (
            <div
              class="body-2xs text-secondary markdown"
              set:html={copyrightHtml}
            />
          )
        }

        {
          legalLinks.length > 0 && (
            <div class="flex gap-column-gap">
              {legalLinks.map((l) => (
                <a class="body-2xs link" href={l.path}>
                  {l.title}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
    <div
      class={cn(
        'col-start-8 col-span-5 xl:col-start-9 xl:col-span-4',
        'flex flex-col justify-end',
        styles.reachOut,
      )}
    >
      <div class={cn('flex flex-col', styles.write)}>
        {newsletter && <NewsletterSignup {...newsletter} />}
      </div>

      {
        socialLinks.length > 0 && (
          <div class={cn('flex items-center', styles.socials)}>
            {socialLinks.map((s) => {
              const icon = iconFor(s.platform);
              return (
                <a href={s.path} aria-label={s.title}>
                  {icon ? <Fragment set:html={icon} /> : s.title}
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</footer>
