---
import cn from 'clsx';
import Divider from '@/components/primitives/Divider';
import TextStack, {
  type TextStackAction,
} from '@/components/composites/TextStack';
import {
  blockDefaults,
  type Spacing,
  type DividerSize,
  type HeadingSize,
  type HeadingTag,
  type ThreadSpan,
} from '@/lib/constants.ts';
import styles from './Block.module.css';

export interface BlockIntro {
  title?: string;
  subtitle?: string;
  description?: string;
  actions?: TextStackAction[];
  titleSize?: HeadingSize;
  titleTag?: HeadingTag;
}

export interface Props {
  threadSpan?: ThreadSpan;
  dividerSize?: DividerSize;
  spacing?: Spacing;
  inset?: boolean;
  intro?: BlockIntro;
}

/**
 * Use this as such in block components:
 * export type Props = BlockComponentProps<MyBlock>;
 *
 * It combines the props from the block wrapper with the actual block props,
 * but handles the case the .default() makes a zod schema required. We don't
 * want to pass all block defaults in every time we're rendering a block.
 */
export type BlockComponentProps<T> = Omit<T, keyof Props> & Props;

const {
  threadSpan,
  dividerSize = blockDefaults.dividerSize,
  spacing = blockDefaults.spacing,
  inset = false,
  intro,
}: Props = Astro.props;

const hasIntro = Boolean(
  intro?.title || intro?.subtitle || intro?.description || intro?.actions?.length,
);
---

<section
  class={styles.root}
  data-spacing={spacing}
  data-divider-size={dividerSize}
>
  {
    hasIntro && (
      <div class={cn('row', 'container', styles.intro)}>
        <TextStack
          className="col-span-12 md:col-span-6"
          title={intro?.title}
          subtitle={intro?.subtitle}
          body={intro?.description}
          actions={intro?.actions}
          titleSize={intro?.titleSize ?? blockDefaults.intro.titleSize}
          titleTag={intro?.titleTag ?? blockDefaults.intro.titleTag}
        />
      </div>
    )
  }
  <Divider threadSpan={threadSpan} size={dividerSize} />
  <div class={styles.content} data-inset={inset ? '' : undefined}>
    <slot />
  </div>
</section>
