---
import Divider from '@/components/primitives/Divider';
import {
  blockDefaults,
  type Spacing,
  type DividerSize,
  type ThreadSpan,
} from '@/lib/constants.ts';
import styles from './Block.module.css';

export interface Props {
  threadSpan?: ThreadSpan;
  dividerSize?: DividerSize;
  spacing?: Spacing;
  inset?: boolean;
}

/**
 * Use this as such in block components:
 * export type Props = BlockComponentProps<MyBlock>;
 *
 * It combines the props from the block wrapper with the actual block props,
 * but handles the case the .default() makes a zod schema required. We don't
 * want to pass all block defaults in every time we're rendering a block.
 */
export type BlockComponentProps<T> = Omit<T, keyof Props> & Props;

const {
  threadSpan,
  dividerSize = blockDefaults.dividerSize,
  spacing = blockDefaults.spacing,
  inset = false,
} = Astro.props;
---

<section
  class={styles.root}
  data-spacing={spacing}
  data-divider-size={dividerSize}
>
  <Divider threadSpan={threadSpan} size={dividerSize} />
  <div class={styles.content} data-inset={inset ? '' : undefined}>
    <slot />
  </div>
</section>
