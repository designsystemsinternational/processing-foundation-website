---
import { getCollection } from 'astro:content';
import Tag from '@/components/primitives/Tag';
import Divider from '@/components/primitives/Divider';
import { blogCategorySlug } from '@/lib/utils.ts';
import styles from './TagsNavigation.module.css';

export interface Props {
  label?: string;
  // CSS selector for the list these tags filter, e.g. '[data-blog-posts]' —
  // flagged with data-category-transitioning on click, before the real
  // navigation happens, purely so it can fade rather than cut on the swap.
  target: string;
}

const { label = 'Filter through categories', target } = Astro.props;

const categories = (await getCollection('blogCategories'))
  .map((category) => ({
    name: category.data.name,
    slug: blogCategorySlug(category.data),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<div>
  <Divider size="s" />
  {
    categories.length > 0 && (
      <nav
        class={styles.root}
        data-tags-navigation
        data-target={target}
        aria-label={label}
      >
        <p class="body-s text-secondary">{label}</p>
        <ul class={styles.list}>
          {categories.map((category) => (
            <li data-category={category.slug}>
              <Tag
                label={category.name}
                href={`/blog?category=${category.slug}`}
                size="small"
              />
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>

<script>
  import { mount, on } from '@/utils/vanilla';

  mount('[data-tags-navigation]', (root, { queryAll }) => {
    const activeCategory = new URLSearchParams(location.search).get(
      'category',
    );
    const target = root.dataset.target
      ? document.querySelector<HTMLElement>(root.dataset.target)
      : null;

    queryAll<HTMLLIElement>('li[data-category]').forEach((item) => {
      const isActive = item.dataset.category === activeCategory;
      item.toggleAttribute('data-active', isActive);

      const link = item.querySelector<HTMLAnchorElement>('a');
      if (!link) return;

      // A real <a href>, so this still works with no JS at all; with JS,
      // clicking the already-active tag clears the filter instead of
      // re-navigating to itself.
      link.href = isActive
        ? '/blog'
        : `/blog?category=${item.dataset.category}`;

      on(link, 'click', () =>
        target?.setAttribute('data-category-transitioning', 'true'),
      );
    });
  });
</script>
