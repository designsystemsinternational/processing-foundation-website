---
import cn from 'clsx';
import { getCollection } from 'astro:content';
import Button from '@/components/primitives/Button';
import Tag from '@/components/primitives/Tag';
import { blogCategorySlug } from '@/lib/utils.ts';
import styles from './TagsNavigation.module.css';
import Block from '@/components/composites/Block';

export interface Props {
  label?: string;
  searchLabel?: string;
  activeCategory?: string;
}

const {
  label = 'Filter through categories',
  searchLabel = 'Search posts',
  activeCategory,
}: Props = Astro.props;

const categories = (await getCollection('blogCategories'))
  .map((category) => ({
    name: category.data.name,
    slug: blogCategorySlug(category.data),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Block spacing="2xl">
  <nav id="tags-navigation" class={cn('row', styles.root)} aria-label={label}>
    <div class="flex flex-wrap items-center justify-between gap-m w-full">
      {categories.length > 0 && <p class="body-s text-secondary">{label}</p>}
      <span class="flex gap-m items-center">
        <span class="body-s text-secondary">... or</span>
        <Button label={searchLabel} href="/blog/search" variant="secondary" />
      </span>
    </div>
    {
      categories.length > 0 && (
        <ul class={styles.list}>
          <li data-active={activeCategory ? undefined : ''}>
            <Tag
              label="All categories"
              href="/blog#tags-navigation"
              size="small"
            />
          </li>
          {categories.map((category) => (
            <li
              data-category={category.slug}
              data-active={category.slug === activeCategory ? '' : undefined}
            >
              <Tag
                label={category.name}
                href={`/blog/category/${category.slug}#tags-navigation`}
                size="small"
              />
            </li>
          ))}
        </ul>
      )
    }
  </nav>
</Block>
