---
import cn from 'clsx';

import styles from './NewsletterSignup.module.css';

import Button from '@/components/primitives/Button';
import Input from '@/components/primitives/Input';

export interface Props {
  helper?: string;
  placeholder: string;
  label: string;
  submitLabel: string;
  size?: 'default' | 'small';
}

const {
  helper,
  placeholder,
  label,
  submitLabel,
  size = 'default',
}: Props = Astro.props;
---

<form
  class={cn('flex flex-col', styles.root)}
  action="/api/newsletter"
  method="post"
  data-newsletter-form
  data-size={size === 'default' ? undefined : size}
>
  {helper && <p class="body-s">{helper}</p>}
  <div class={cn('flex', styles.inputWrapper)}>
    <Input
      label={label}
      name="email"
      type="email"
      placeholder={placeholder}
      autocomplete="email"
      required
      showLabel={false}
      size={size}
      className="flex-1"
      inputClassName="flex-1"
    />
    <Button type="submit" label={submitLabel} />
  </div>
  <input
    class={styles.honeypot}
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <p class={cn('body-2xs', styles.status)} role="status" data-newsletter-status>
  </p>
</form>

<script>
  import { initNewsletterSignup } from './newsletterSignup.ts';

  document
    .querySelectorAll<HTMLFormElement>('[data-newsletter-form]')
    .forEach(initNewsletterSignup);
</script>
