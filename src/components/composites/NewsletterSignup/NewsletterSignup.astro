---
import cn from 'clsx';

import styles from './NewsletterSignup.module.css';

import Button from '@/components/primitives/Button';
import Input from '@/components/primitives/Input';

export interface Props {
  helper?: string;
  placeholder: string;
  label: string;
  submitLabel: string;
  size?: 'default' | 'small';
}

const {
  helper,
  placeholder,
  label,
  submitLabel,
  size = 'default',
} = Astro.props;
---

<div
  class={cn('flex flex-col', styles.root)}
  data-size={size === 'default' ? undefined : size}
>
  {helper && <p class="body-s">{helper}</p>}
  <div class={cn('flex', styles.inputWrapper)}>
    <Input
      label={label}
      name="email"
      type="email"
      placeholder={placeholder}
      showLabel={false}
      size={size}
      className="flex-1"
    />
    {/* TODO: Link to actual subscription platform */}
    <Button label={submitLabel} />
  </div>
</div>
