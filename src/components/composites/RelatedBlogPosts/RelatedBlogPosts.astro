---
import { type CollectionEntry, getCollection } from 'astro:content';
import cn from 'clsx';
import BlogPostCard from '@/components/composites/BlogPostCard';
import styles from './RelatedBlogPosts.module.css';

interface Props {
  posts?: CollectionEntry<'blogPosts'>[];
  title?: string;
  showSeeAllLink?: boolean;
  category?: string;
  excludeId?: string;
  count?: number;
}

const {
  posts: given,
  title = 'More from the blog',
  showSeeAllLink = true,
  category,
  excludeId,
  count = 3,
}: Props = Astro.props;

async function newestPosts() {
  const candidates = (await getCollection('blogPosts'))
    .filter((post) => post.id !== excludeId)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const inCategory = category
    ? candidates.filter((post) => post.data.category === category)
    : [];

  return [
    ...inCategory,
    ...candidates.filter((post) => !inCategory.includes(post)),
  ].slice(0, count);
}

const posts = given ?? (await newestPosts());
---

{
  posts.length > 0 && (
    <nav
      class="container mt-internal-section-gap"
      aria-labelledby="related-blog-posts"
    >
      <div
        class="row"
        data-variant="intersection"
        data-align="stretch"
        data-gutter="gradient"
        data-size="none"
        data-corner-top
        data-corner-size="s"
      >
        <div class={cn('col-span-12 md:col-span-3', styles.header)}>
          <h2 id="related-blog-posts" class="heading-s">
            {title}
          </h2>
          {showSeeAllLink && (
            <a class={cn('body-m', styles.link)} href="/blog">
              See all posts
            </a>
          )}
        </div>
        {posts.map((post) => (
          <BlogPostCard
            entry={post}
            showSubtitle={false}
            className="col-span-12 sm:col-span-6 md:col-span-3"
          />
        ))}
      </div>
    </nav>
  )
}
