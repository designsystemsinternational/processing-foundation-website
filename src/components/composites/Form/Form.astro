---
import cn from 'clsx';
import type { HTMLAttributes } from 'astro/types';
import Button from '@/components/primitives/Button';
import styles from './Form.module.css';

export interface Props extends Omit<
  HTMLAttributes<'form'>,
  'method' | 'class'
> {
  title?: string;
  action?: string;
  method?: 'get' | 'post';
  submitLabel?: string;
  className?: string;
}

const {
  title,
  action,
  method = 'post',
  submitLabel = 'Send',
  className,
  ...attrs
} = Astro.props;
---

<form
  class={cn(
    'flex flex-col gap-column-gap py-2xl px-xl bg-secondary',
    styles.root,
    className,
  )}
  action={action}
  method={method}
  {...attrs}
>
  {title && <p class="heading-xs text-primary">{title}</p>}

  <div class={styles.fields}>
    <slot />
  </div>

  <div class="flex flex-col items-start gap-l">
    <Button type="submit" label={submitLabel} />
    <slot name="status" />
  </div>
</form>
