---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import cn from 'clsx';
import Image from '@/components/primitives/Image';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Pagination from '@/components/primitives/Pagination';
import Selector from '@/components/primitives/Selector';
import Tag from '@/components/primitives/Tag/Tag.astro';
import { personRoles, type PersonRole } from '@/lib/constants.ts';
import { personPath } from '@/lib/utils.ts';
import styles from './PeopleGrid.module.css';

interface Props {
  page: Page<CollectionEntry<'people'>>;
  pageUrls: Record<number, string>;
  currentRole?: PersonRole;
}

const { page, pageUrls, currentRole }: Props = Astro.props;

const roleOptions = [
  { label: 'All roles', value: '' },
  ...personRoles.map((role) => ({ label: role, value: role })),
];
---

<div
  id="people-grid"
  class="flex flex-col items-center container"
  data-people-grid
>
  <div class="row w-full">
    <Selector
      label="Select role"
      options={roleOptions}
      defaultValue={currentRole ?? ''}
      className="col-span-12 sm:col-span-6 sm:col-start-7 md:col-span-4 md:col-start-9"
    />
  </div>
  <div class="layout-grid w-full">
    <div
      class="row"
      data-variant="intersection"
      data-align="stretch"
      data-gutter="gradient"
      data-size="none"
      data-corner-top
      data-corner-size="xs"
    >
      {
        page.data.map(({ id, data }) => (
          <a
            class={cn('col-span-6 sm:col-span-3 md:col-span-2', styles.person)}
            href={personPath(id)}
          >
            <div class={styles.photo}>
              {data.image?.src ? (
                <Image
                  alt={data.image.alt}
                  src={data.image.src}
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 56rem) 16.67vw, 50vw"
                />
              ) : (
                <ImagePlaceholder />
              )}
            </div>
            <div class={styles.information}>
              <div class={styles.text}>
                <p class="heading-2xs">{data.name}</p>
                <p class="body-2xs">{data.title}</p>
              </div>
              <div class={styles.tags}>
                {data.roles?.map((role) => (
                  <Tag label={role} size="small" />
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  {
    page.lastPage > 1 && (
      <Pagination
        page={page}
        pageUrls={pageUrls}
        className="mt-internal-section-gap"
      />
    )
  }
</div>

<script>
  import { slugify } from '@/lib/utils.ts';
  import { initOnPageLoad } from '@/lib/dom.ts';

  initOnPageLoad<HTMLElement>('[data-people-grid]', (root) => {
    root.addEventListener('selector:change', (event) => {
      const { value } = (event as CustomEvent<{ value: string }>).detail;
      const path = value ? `/about/people/${slugify(value)}` : '/about/people';
      window.location.assign(`${path}#people-grid`);
    });
  });
</script>
