---
import cn from 'clsx';
import ButtonGroup from '@/components/composites/ButtonGroup';
import Button from '@/components/primitives/Button';
import type {
  BodySize,
  ButtonIcon,
  ButtonVariant,
  HeadingSize,
  HeadingTag,
  Spacing,
} from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';
import styles from './TextStack.module.css';

export interface TextStackAction {
  variant?: ButtonVariant;
  icon?: ButtonIcon;
  label: string;
  href: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  body?: Html;
  actions?: TextStackAction[];
  titleSize?: HeadingSize;
  titleTag?: HeadingTag;
  subtitleSize?: HeadingSize;
  bodySize?: BodySize;
  titleSpacing?: Spacing;
  bodyColumns?: boolean;
  gap?: Spacing;
  className?: string;
}

const {
  title,
  subtitle,
  body,
  actions = [],
  titleSize = 'm',
  titleTag: TitleTag = 'h2',
  subtitleSize = 'xs',
  bodySize = 's',
  titleSpacing = 'xl',
  bodyColumns = false,
  gap = 'l',
  className,
}: Props = Astro.props;
---

<div class={cn(styles.root, className)} data-gap={gap}>
  {
    title && (
      <TitleTag class={`heading-${titleSize} mb-${titleSpacing}`}>
        {title}
      </TitleTag>
    )
  }
  {
    subtitle && (
      <p class={`heading-${subtitleSize} text-secondary`}>{subtitle}</p>
    )
  }
  {
    body && (
      <div
        class={cn(`body-${bodySize} markdown`, styles.prose, {
          [styles.columns]: bodyColumns,
        })}
        set:html={body}
      />
    )
  }
  {
    actions.length > 0 && (
      <div class="mt-xl">
        {actions.length === 2 ? (
          <ButtonGroup hasAccent={actions.some((a) => a.variant === 'accent')}>
            {actions.map((a) => (
              <Button {...a} />
            ))}
          </ButtonGroup>
        ) : (
          <Button {...actions[0]} />
        )}
      </div>
    )
  }
</div>
