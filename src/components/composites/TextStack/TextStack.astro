---
import cn from 'clsx';
import ButtonGroup from '@/components/composites/ButtonGroup';
import Button from '@/components/primitives/Button';
import type {
  ButtonVariant,
  HeadingSize,
  HeadingTag,
  Spacing,
} from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';
import styles from './TextStack.module.css';

export interface TextStackAction {
  variant?: ButtonVariant;
  label: string;
  href: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  body?: Html;
  actions?: TextStackAction[];
  titleSize?: HeadingSize;
  titleTag?: HeadingTag;
  bodyColumns?: boolean;
  gap?: Spacing;
  className?: string;
}

const {
  title,
  subtitle,
  body,
  actions = [],
  titleSize = 'm',
  titleTag: TitleTag = 'h2',
  bodyColumns = false,
  gap = 'l',
  className,
}: Props = Astro.props;
---

<div class={cn(styles.root, className)} data-gap={gap}>
  {title && <TitleTag class={`heading-${titleSize} mb-xl`}>{title}</TitleTag>}
  {subtitle && <p class="heading-xs text-secondary">{subtitle}</p>}
  {
    body && (
      <div
        class={cn('body-s markdown', styles.prose, {
          [styles.columns]: bodyColumns,
        })}
        set:html={body}
      />
    )
  }
  {
    actions.length > 0 && (
      <div class="mt-xl">
        {actions.length === 2 ? (
          <ButtonGroup hasAccent={actions.some((a) => a.variant === 'accent')}>
            {actions.map((a) => (
              <Button variant={a.variant} href={a.href} label={a.label} />
            ))}
          </ButtonGroup>
        ) : (
          <Button
            variant={actions[0].variant}
            href={actions[0].href}
            label={actions[0].label}
          />
        )}
      </div>
    )
  }
</div>
