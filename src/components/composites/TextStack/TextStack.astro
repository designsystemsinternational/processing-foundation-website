---
import cn from 'clsx';
import { marked } from 'marked';
import ButtonGroup from '@/components/composites/ButtonGroup';
import Button from '@/components/primitives/Button';
import type {
  ButtonVariant,
  HeadingSize,
  HeadingTag,
  Spacing,
} from '@/lib/constants.ts';
import styles from './TextStack.module.css';

export interface TextStackAction {
  variant: ButtonVariant;
  label: string;
  href: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  body?: string;
  actions?: TextStackAction[];
  titleSize?: HeadingSize;
  titleTag?: HeadingTag;
  bodyColumns?: boolean;
  gap?: Spacing;
  className?: string;
}

const {
  title,
  subtitle,
  body,
  actions = [],
  titleSize = 'm',
  titleTag: TitleTag = 'h2',
  bodyColumns = false,
  gap = 'l',
  className,
}: Props = Astro.props;

const bodyHtml = body ? await marked.parse(body) : null;
---

<div class={cn(styles.root, className)} data-gap={gap}>
  {title && <TitleTag class={`heading-${titleSize}`}>{title}</TitleTag>}
  {subtitle && <p class="heading-xs text-secondary">{subtitle}</p>}
  {
    bodyHtml && (
      <div
        class={cn('body-m', styles.prose, { [styles.columns]: bodyColumns })}
        set:html={bodyHtml}
      />
    )
  }
  {
    actions.length > 0 && (
      <div>
        {actions.length === 2 ? (
          <ButtonGroup hasAccent={actions.some((a) => a.variant === 'accent')}>
            {actions.map((a) => (
              <Button variant={a.variant} href={a.href} label={a.label} />
            ))}
          </ButtonGroup>
        ) : (
          <Button
            variant={actions[0].variant}
            href={actions[0].href}
            label={actions[0].label}
          />
        )}
      </div>
    )
  }
</div>
