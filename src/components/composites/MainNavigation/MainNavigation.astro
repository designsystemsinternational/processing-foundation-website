---
import cn from 'clsx';

import Button from '@/components/primitives/Button';

import { isCurrentPage, isInTrail } from '@/lib/navigation.ts';
import { slugify } from '@/lib/utils.ts';
import type { NavigationItem } from '@/schemas/navigation.ts';

import PFLogo from '@/assets/media/ProcessingFoundation-logo.svg';

import styles from './MainNavigation.module.css';

interface Props {
  items: NavigationItem[];
  currentPath: string;
}

const { items, currentPath }: Props = Astro.props;

const blogPath = '/blog';
const donatePath = '/support/donate';
---

<header class={styles.root} data-main-nav>
  <div class={cn('row', styles.desktop)}>
    <div class={styles.bar}>
      <div class={styles.logo}>
        <a href={'/'} aria-label="Home">
          <PFLogo />
        </a>
      </div>

      <div class={styles.desktopRight}>
        <nav aria-label="Main" class={styles.desktopNav}>
          <ul class={styles.desktopList}>
            {
              items.map((item) => {
                const children = item.children ?? [];
                return (
                  <li
                    class={styles.desktopItem}
                    data-current-trail={
                      isInTrail(item, currentPath) ? '' : undefined
                    }
                  >
                    {item.path ? (
                      <a
                        class={styles.navLabel}
                        href={item.path}
                        aria-current={
                          isCurrentPage(item.path, currentPath)
                            ? 'page'
                            : undefined
                        }
                      >
                        {item.title}
                      </a>
                    ) : (
                      <span class={cn(styles.navLabel, styles.staticLabel)}>
                        {item.title}
                      </span>
                    )}

                    {children.length > 0 && (
                      <div class={styles.dropdown}>
                        <ul class={styles.dropdownList}>
                          {children.map((child) => (
                            <li>
                              <a
                                class={cn(styles.dropdownLink, styles.subLabel)}
                                href={child.path}
                                aria-current={
                                  isCurrentPage(child.path, currentPath)
                                    ? 'page'
                                    : undefined
                                }
                              >
                                {child.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <div class={styles.desktopActions}>
          <Button label="Blog" href={blogPath} variant="secondary" />
          <Button
            label="Donate"
            href={donatePath}
            variant="primary"
            icon="heart"
          />
        </div>
      </div>
    </div>
  </div>

  <div class={styles.mobile}>
    <div class={styles.bar}>
      <div class={styles.logo}>
        <a href={'/'} aria-label="Home">
          <PFLogo />
        </a>
      </div>

      <button
        type="button"
        class={styles.burger}
        data-main-nav-burger
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="main-navigation-menu"
      >
        <svg width="20" height="15" viewBox="0 0 20 15" aria-hidden="true">
          <rect class={styles.burgerBar} width="20" height="2" y="0.5"></rect>
          <rect class={styles.burgerBar} width="20" height="2" y="6.5"></rect>
          <rect class={styles.burgerBar} width="20" height="2" y="12.5"></rect>
        </svg>
      </button>
    </div>

    <div id="main-navigation-menu" class={styles.collapse} data-open="false">
      <div class={styles.collapseInner}>
        <nav aria-label="Main">
          <ul class={styles.list}>
            {
              items.map((item) => {
                const children = item.children ?? [];
                const sublistId = `main-navigation-${slugify(item.title)}`;

                return (
                  <li class={styles.item}>
                    {children.length > 0 ? (
                      <button
                        type="button"
                        class={cn(styles.row, styles.navLabel)}
                        data-main-nav-toggle
                        aria-expanded="false"
                        aria-controls={sublistId}
                      >
                        {item.title}
                        <span class={styles.toggle} aria-hidden="true" />
                      </button>
                    ) : item.path ? (
                      <a
                        class={cn(styles.row, styles.navLabel)}
                        href={item.path}
                        aria-current={
                          isCurrentPage(item.path, currentPath)
                            ? 'page'
                            : undefined
                        }
                      >
                        {item.title}
                      </a>
                    ) : (
                      <span
                        class={cn(
                          styles.row,
                          styles.navLabel,
                          styles.staticLabel,
                        )}
                      >
                        {item.title}
                      </span>
                    )}

                    {children.length > 0 && (
                      <div
                        id={sublistId}
                        class={styles.collapse}
                        data-open="false"
                      >
                        <div class={styles.collapseInner}>
                          <ul class={styles.sublist}>
                            {children.map((child) => (
                              <li class={styles.item}>
                                <a
                                  class={cn(
                                    styles.row,
                                    styles.subRow,
                                    styles.subLabel,
                                  )}
                                  href={child.path}
                                  aria-current={
                                    isCurrentPage(child.path, currentPath)
                                      ? 'page'
                                      : undefined
                                  }
                                >
                                  {child.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    )}
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <div class={styles.actions}>
          <Button label="Blog" href={blogPath} variant="secondary" />
          <Button
            label="Donate"
            href={donatePath}
            variant="primary"
            icon="heart"
          />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setExpanded(button: HTMLElement, isOpen: boolean) {
    button.setAttribute('aria-expanded', String(isOpen));

    const id = button.getAttribute('aria-controls');
    const collapse = id ? document.getElementById(id) : null;
    collapse?.setAttribute('data-open', String(isOpen));
  }

  document.querySelectorAll<HTMLElement>('[data-main-nav]').forEach((nav) => {
    const burger = nav.querySelector<HTMLElement>('[data-main-nav-burger]');

    burger?.addEventListener('click', () => {
      const isOpen = burger.getAttribute('aria-expanded') !== 'true';
      setExpanded(burger, isOpen);
      burger.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    const toggles = nav.querySelectorAll<HTMLElement>('[data-main-nav-toggle]');

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') !== 'true';
        toggles.forEach((other) => setExpanded(other, false));
        setExpanded(toggle, isOpen);
      });
    });
  });
</script>
