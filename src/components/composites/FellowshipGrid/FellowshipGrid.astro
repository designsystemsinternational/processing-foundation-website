---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import cn from 'clsx';
import Image from '@/components/primitives/Image';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Pagination from '@/components/primitives/Pagination';
import Selector from '@/components/primitives/Selector';
import { fellowshipPath } from '@/lib/utils.ts';
import styles from './FellowshipGrid.module.css';

interface Props {
  page: Page<CollectionEntry<'fellowships'>>;
  pageUrls: Record<number, string>;
  years: string[];
  currentYear?: string;
}

const { page, pageUrls, years, currentYear }: Props = Astro.props;

const yearOptions = [
  { label: 'All years', value: '' },
  ...years.map((year) => ({ label: year, value: year })),
];

const columns = {
  thumbnail: 'col-span-6 md:col-span-2',
  year: 'col-span-6 md:col-span-2',
  fellows: 'col-span-6 md:col-span-4',
  title: 'col-span-6 md:col-span-4',
};
---

<section
  class="flex flex-col items-center gap-internal-section-gap mt-section-gap container"
  aria-labelledby="fellowship-grid-heading"
  data-fellowship-grid
>
  <div id="fellowship-grid" class="layout-grid w-full">
    <div class="row mb-2xl">
      <h2
        id="fellowship-grid-heading"
        class="heading-m col-span-12 md:col-span-8"
      >
        {currentYear ? `${currentYear} fellowships` : 'All fellowships'}
      </h2>
    </div>

    <div
      class={cn('row', styles.mobileHead)}
      data-size="xs"
      data-divider-top
      data-divider
    >
      <div class={cn('col-span-6', styles.year)}>
        <Selector
          label="Select year"
          options={yearOptions}
          defaultValue={currentYear ?? ''}
          className={styles.yearsSelector}
        />
      </div>
      <div class={cn('col-span-6 body-xs', styles.project)}>
        Name / Project Name
      </div>
    </div>

    <div
      class={cn('row', styles.head)}
      data-size="xs"
      data-divider-top
      data-divider
    >
      <div class={columns.thumbnail}></div>

      <div class={cn(columns.year, 'body-xs', styles.year)}>
        <Selector
          label="Select year"
          options={yearOptions}
          defaultValue={currentYear ?? ''}
          className={styles.yearsSelector}
        />
      </div>
      <div class={cn(columns.fellows, 'body-xs bolder', styles.name)}>Name</div>
      <div class={cn(columns.title, 'body-xs', styles.project)}>
        Project Name
      </div>
    </div>

    {
      page.data.map(({ id, data }) => (
        <a
          class={cn('row', styles.entry)}
          href={fellowshipPath(id)}
          data-size="xs"
          data-divider
        >
          <div class={cn(columns.thumbnail, styles.thumbnail)}>
            {data.image?.src ? (
              <Image
                {...data.image}
                src={data.image.src}
                captionSize="2xs"
                widths={[200, 400, 600]}
                sizes="(min-width: 56rem) 17vw, 50vw"
              />
            ) : (
              <ImagePlaceholder patterned={false} />
            )}
          </div>
          <div class={cn(columns.year, 'body-xs')}>{data.year}</div>
          <div class={cn(columns.fellows, 'body-xs')}>
            {data.fellows.join(', ')}
          </div>
          <div class={cn(columns.title, 'body-xs')}>{data.title}</div>
        </a>
      ))
    }
  </div>

  {page.lastPage > 1 && <Pagination page={page} pageUrls={pageUrls} />}
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-fellowship-grid]')
    .forEach((root) => {
      root.addEventListener('selector:change', (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        const path = value
          ? `/programs/fellowships/${value}`
          : '/programs/fellowships';
        window.location.assign(`${path}#fellowship-grid`);
      });
    });
</script>
