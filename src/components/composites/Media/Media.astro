---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Figure from '@/components/primitives/Figure';
import Image from '@/components/primitives/Image';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Sketch from '@/components/primitives/Sketch';
import Vimeo from '@/components/primitives/Vimeo';
import YouTube from '@/components/primitives/YouTube';
import type { CaptionSize } from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';
import { videoProvider } from '@/lib/media.ts';
import { sketchUrl } from '@/lib/sketch.ts';

/**
 * Renders a media item (image, video, sketch) stretched to
 * the width of its parent.
 */
export interface Props {
  src?: ImageMetadata;
  alt?: string;
  videoUrl?: string;
  sketch?: string;
  caption?: Html;
  captionSize?: CaptionSize;
  widths?: number[];
  sizes?: string;
  className?: string;
  showPlaceholder?: boolean;
}

const {
  src,
  alt,
  videoUrl,
  sketch,
  caption,
  captionSize,
  widths,
  sizes,
  className,
  showPlaceholder = true,
}: Props = Astro.props;

const entry = sketch ? await getEntry('sketches', sketch) : undefined;
if (sketch && !entry) {
  console.warn(
    `[Media] No sketch folder at public/sketches/${sketch}/. Remove the sketch from the entry that points at it.`,
  );
}
const provider = videoUrl ? videoProvider(videoUrl) : undefined;
---

{
  entry ? (
    <Sketch
      src={sketchUrl(entry.id)}
      width={entry.data.width}
      height={entry.data.height}
      title={alt ?? entry.data.title}
      {caption}
      {captionSize}
      {className}
    />
  ) : videoUrl && provider === 'youtube' ? (
    <YouTube url={videoUrl} title={alt} {caption} {captionSize} {className} />
  ) : videoUrl && provider === 'vimeo' ? (
    <Vimeo url={videoUrl} title={alt} {caption} {captionSize} {className} />
  ) : src ? (
    <Image {src} {alt} {caption} {captionSize} {widths} {sizes} {className} />
  ) : (
    showPlaceholder && (
      <Figure {caption} {captionSize} {className}>
        <ImagePlaceholder />
      </Figure>
    )
  )
}
