---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Figure from '@/components/primitives/Figure';
import Image from '@/components/primitives/Image';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Sketch from '@/components/primitives/Sketch';
import YouTube from '@/components/primitives/YouTube';
import type { CaptionSize } from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';

/**
 * One media item, stretched to the width of its parent like Image is. The
 * fields come straight from the `media` schema in src/schemas/shared.ts, where
 * all of them are optional and none of them discriminates — so the editor fills
 * in the one they want and this picks by precedence.
 */
export interface Props {
  src?: ImageMetadata;
  alt?: string;
  youtubeUrl?: string;
  sketch?: string;
  caption?: Html;
  captionSize?: CaptionSize;
  widths?: number[];
  sizes?: string;
  className?: string;
  /** Set false where an unfilled item should collapse instead of holding space. */
  showPlaceholder?: boolean;
}

const {
  src,
  alt,
  youtubeUrl,
  sketch,
  caption,
  captionSize,
  widths,
  sizes,
  className,
  showPlaceholder = true,
}: Props = Astro.props;

const entry = sketch ? await getEntry('sketches', sketch) : undefined;
---

{
  entry ? (
    <Sketch
      js={entry.body ?? ''}
      width={entry.data.width}
      height={entry.data.height}
      css={entry.data.css}
      htmlBody={entry.data.htmlBody}
      scripts={entry.data.scripts}
      title={alt ?? entry.data.title}
      {caption}
      {captionSize}
      {className}
    />
  ) : youtubeUrl ? (
    <YouTube url={youtubeUrl} title={alt} {caption} {captionSize} {className} />
  ) : src ? (
    <Image {src} {alt} {caption} {captionSize} {widths} {sizes} {className} />
  ) : (
    showPlaceholder && (
      // Still a Figure, so an item an editor has not filled in keeps its
      // caption and lines up with its siblings in a gallery.
      <Figure {caption} {captionSize} {className}>
        <ImagePlaceholder />
      </Figure>
    )
  )
}
