---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import cn from 'clsx';
import ImagePlaceholder from '@/components/primitives/ImagePlaceholder';
import Tag from '@/components/primitives/Tag';
import {
  blogPostPath,
  readingTime,
  dateLabel,
  dateIso,
  readTimeDatetime,
  readTimeLabel,
} from '@/lib/utils.ts';
import styles from './BlogPostCard.module.css';

interface Props {
  entry: CollectionEntry<'blogPosts'>;
  showSubtitle?: boolean;
  className?: string;
}

const THUMBNAIL_WIDTH = 1280;
const THUMBNAIL_HEIGHT = (THUMBNAIL_WIDTH * 3) / 4;
const THUMBNAIL_WIDTHS = [384, 512, 768, 1024, THUMBNAIL_WIDTH];
// The card spans 4 of the 12 columns above --md, 6 above --sm, and all 12
// below; --container-width caps it at 501px. --spacing-column-gap is fluid, so
// each arm rounds up off a measured slot rather than subtracting a fixed gutter
// — under-stating any arm costs sharpness.
const THUMBNAIL_SIZES = [
  '(min-width: 1600px) 510px',
  '(min-width: 56rem) 33vw',
  '(min-width: 42rem) 50vw',
  '95vw',
].join(', ');

const { entry, showSubtitle = true, className }: Props = Astro.props;
const post = entry.data;

const href = blogPostPath(post);
const readTime = readingTime(entry.body ?? '');
---

<a class={cn(styles.card, className)} href={href}>
  <div class={styles.photo}>
    {
      post.indexImage ? (
        <Image
          src={post.indexImage}
          alt=""
          widths={THUMBNAIL_WIDTHS}
          sizes={THUMBNAIL_SIZES}
        />
      ) : post.headerImage ? (
        <Image
          src={post.headerImage}
          alt=""
          width={THUMBNAIL_WIDTH}
          height={THUMBNAIL_HEIGHT}
          widths={THUMBNAIL_WIDTHS}
          sizes={THUMBNAIL_SIZES}
          fit="cover"
          position={post.headerImagePosition ?? 'center'}
        />
      ) : (
        <ImagePlaceholder aspectRatio="landscape" />
      )
    }
  </div>
  <div class={styles.information}>
    <div class={styles.text}>
      <p class={cn('body-2xs', styles.meta)}>
        <span>by {post.author.join(', ')}</span>
      </p>
      <p class="heading-xs">{post.title}</p>
      {
        showSubtitle && post.subtitle && (
          <p class={cn('body-xs', styles.subtitle)}>{post.subtitle}</p>
        )
      }
    </div>
    <div class="flex flex-row justify-between items-center gap-s">
      {
        post.categories && post.categories.length > 0 && (
          <div class={styles.tags}>
            {post.categories.map((category) => (
              <Tag label={category} size="small" />
            ))}
          </div>
        )
      }
      <div class="body-2xs text-secondary">
        <time datetime={dateIso(post.date)}>{dateLabel(post.date)}</time> /{' '}
        <time datetime={readTimeDatetime(readTime)}>
          {readTimeLabel(readTime)}
        </time>
      </div>
    </div>
  </div>
</a>
