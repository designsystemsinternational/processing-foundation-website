---
import cn from 'clsx';
import {
  blockDefaults,
  type DividerSize,
  type DividerVariant,
  type ThreadSpan,
} from '@/lib/constants.ts';
import styles from './Divider.module.css';

export interface Props {
  threadSpan?: ThreadSpan;
  size?: DividerSize;
  variant?: DividerVariant;
  className?: string;
}

const {
  threadSpan = blockDefaults.threadSpan,
  size = blockDefaults.dividerSize,
  variant = blockDefaults.dividerVariant,
  className,
}: Props = Astro.props;
---

<div
  class={cn(styles.root, className)}
  data-size={size}
  style={{ '--thread-span': threadSpan }}
  data-variant={variant}
>
</div>
