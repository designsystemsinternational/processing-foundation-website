---
import Figure from '@/components/primitives/Figure';
import type { CaptionSize } from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';
import { vimeoEmbedUrl, vimeoVideo } from '@/lib/media.ts';

export interface Props {
  url: string;
  title?: string;
  caption?: Html;
  captionSize?: CaptionSize;
  className?: string;
}

const { url, title, caption, captionSize, className }: Props = Astro.props;

const video = vimeoVideo(url);
---

{
  video && (
    <Figure {caption} {captionSize} {className} aspectRatio="16 / 9">
      <iframe
        src={vimeoEmbedUrl(video)}
        title={title ?? 'Vimeo video'}
        loading="lazy"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
        allowfullscreen
      />
    </Figure>
  )
}
