---
import styles from "./Tag.module.css";

interface Props {
  label: string;
  href?: string;
  size?: "default" | "small";
}

const { label, href, size = "default" }: Props = Astro.props;
const Element = href ? "a" : "span";
---

<Element
  href={href}
  class={styles.tag}
  data-size={size === "default" ? undefined : size}
>
  {label}
</Element>
