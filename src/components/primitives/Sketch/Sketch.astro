---
import Figure from '@/components/primitives/Figure';
import type { CaptionSize } from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';

export interface Props {
  src: string;
  width: number;
  height: number;
  title?: string;
  caption?: Html;
  captionSize?: CaptionSize;
  className?: string;
}

const { src, width, height, title, caption, captionSize, className }: Props =
  Astro.props;
---

<Figure
  {caption}
  {captionSize}
  {className}
  aspectRatio={`${width} / ${height}`}
>
  {/* allow-same-origin, because an opaque origin taints every texture a WEBGL
  sketch loads from its own folder, and no CORS header lifts that. It puts
  sketch code on the site's origin — the same trust as any other script in
  this repo. */}
  <iframe
    {src}
    sandbox="allow-scripts allow-same-origin allow-popups allow-modals allow-forms"
    loading="lazy"
    title={title ?? 'p5 sketch'}
    data-sketch></iframe>
</Figure>

<script>
  import { initSketchVisibility } from './visibility.ts';
  import { initOnPageLoad } from '@/lib/dom.ts';

  initOnPageLoad('iframe[data-sketch]', initSketchVisibility);
</script>
