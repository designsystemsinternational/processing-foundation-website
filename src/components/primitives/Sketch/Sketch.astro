---
import Figure from '@/components/primitives/Figure';
import type { CaptionSize } from '@/lib/constants.ts';
import type { Html } from '@/lib/html.ts';
import { sketchDocument } from '@/lib/sketch.ts';

export interface Props {
  js: string;
  width: number;
  height: number;
  css?: string;
  htmlBody?: string;
  scripts?: string[];
  base?: string;
  title?: string;
  caption?: Html;
  captionSize?: CaptionSize;
  className?: string;
}

const {
  js,
  width,
  height,
  css,
  htmlBody,
  scripts,
  base,
  title,
  caption,
  captionSize,
  className,
}: Props = Astro.props;
---

<Figure
  {caption}
  {captionSize}
  {className}
  aspectRatio={`${width} / ${height}`}
>
  <iframe
    srcdoc={sketchDocument({ js, css, htmlBody, scripts, base })}
    sandbox="allow-scripts allow-popups allow-modals allow-forms"
    loading="lazy"
    title={title ?? 'p5 sketch'}
    data-sketch></iframe>
</Figure>

<script>
  import { initSketchVisibility } from './visibility.ts';
  import { initOnPageLoad } from '@/lib/dom.ts';

  initOnPageLoad('iframe[data-sketch]', initSketchVisibility);
</script>
