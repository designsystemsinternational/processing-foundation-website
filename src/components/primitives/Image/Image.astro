---
import type { ImageMetadata } from 'astro';
import cn from 'clsx';
import { Image as AstroImage } from 'astro:assets';
import { marked } from 'marked';
import styles from './Image.module.css';

export interface Props {
  image: ImageMetadata;
  alt?: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  className?: string;
}

const { image, caption, alt = '', widths, sizes, className } = Astro.props;
const captionHtml = caption ? await marked.parseInline(caption) : null;
---

<figure class={cn(styles.root, className)}>
  <AstroImage
    src={image}
    alt={alt}
    layout="full-width"
    widths={widths}
    sizes={sizes}
  />
  {captionHtml && <figcaption set:html={captionHtml} />}
</figure>
