---
import type { ImageMetadata } from 'astro';
import cn from 'clsx';
import { Image as AstroImage } from 'astro:assets';
import { marked } from 'marked';
import type { CaptionSize } from '@/lib/constants.ts';
import styles from './Image.module.css';

export interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  captionSize?: CaptionSize;
  widths?: number[];
  sizes?: string;
  className?: string;
}

const {
  src,
  caption,
  captionSize,
  alt = '',
  widths,
  sizes,
  className,
}: Props = Astro.props;
const captionHtml = caption ? await marked.parseInline(caption) : null;
---

<figure class={cn(styles.root, className)} data-caption-size={captionSize}>
  <AstroImage
    {src}
    alt={alt}
    layout="full-width"
    widths={widths}
    sizes={sizes}
  />
  {captionHtml && <figcaption set:html={captionHtml} />}
</figure>
