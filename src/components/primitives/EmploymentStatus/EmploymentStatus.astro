---
import type { EmploymentStatusModes } from '@/lib/constants';
import { FulltimeIcon, PartTimeIcon, FreelanceIcon } from '../Icons/index.ts';
import type { LabelsType } from '@/lib/constants';

import styles from './EmploymentStatus.module.css';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Props {
  mode: EmploymentStatusModes;
}

interface ModeAssets {
  Icon: AstroComponentFactory;
  label: LabelsType;
}

const label: Record<EmploymentStatusModes, ModeAssets> = {
  'full-time': {
    Icon: FulltimeIcon,
    label: 'Full-time',
  },
  'part-time': {
    Icon: PartTimeIcon,
    label: 'Part-time',
  },
  freelance: {
    Icon: FreelanceIcon,
    label: 'Freelance',
  },
};

const { mode = 'full-time' } = Astro.props;
const Icon = label[mode].Icon;
---

<div class={styles.root} data-variant={mode}>
  <Icon size={20} className={styles.icon} />
  <span class="body-s">{label[mode].label}</span>
</div>
