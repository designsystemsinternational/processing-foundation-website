---
import type { AspectRatio } from '@/lib/constants.ts';
import styles from './ImagePlaceholder.module.css';

interface Props {
  patterned?: boolean;
  patternTheme?: 'primary' | 'secondary' | 'accent';
  aspectRatio?: AspectRatio;
}

const {
  patterned = true,
  aspectRatio = 'square',
  patternTheme = 'primary',
}: Props = Astro.props;
---

<div
  class={styles.root}
  data-patterned={patterned}
  data-pattern-theme={patternTheme}
  data-aspect-ratio={aspectRatio}
>
</div>
