---
export interface Props {
  direction: "left" | "right";
  size: number;
}

const { direction, size } = Astro.props;
---

<svg
  style={{
    transform: direction === "left" ? "scaleX(-1)" : undefined,
  }}
  viewBox="0 0 8 11"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
>
  <path
    d="M0.25 0.333496L6.91667 5.3335L0.25 10.3335"
    stroke="currentColor"
    stroke-width="0.833333"
  />
</svg>
