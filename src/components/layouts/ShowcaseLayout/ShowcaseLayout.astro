---
import type { CollectionEntry } from 'astro:content';
import ShowcaseChannel from '@/components/blocks/ShowcaseChannel';
import PageLayout from '@/components/layouts/PageLayout';

interface Props {
  entry: CollectionEntry<'pages'>;
  channels: string[];
}

const { entry, channels }: Props = Astro.props;
---

<PageLayout entry={entry}>
  <main>
    {
      channels.map((channel) => (
        <ShowcaseChannel type="showcaseChannel" channel={channel} />
      ))
    }
  </main>
</PageLayout>
