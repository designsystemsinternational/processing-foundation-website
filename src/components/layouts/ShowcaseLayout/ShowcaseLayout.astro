---
import type { CollectionEntry } from 'astro:content';
import cn from 'clsx';
import Images from '@/components/blocks/Images';
import PageLayout from '@/components/layouts/PageLayout';
import styles from './ShowcaseLayout.module.css';

interface Props {
  entry: CollectionEntry<'pages'>;
  channels: CollectionEntry<'showcase'>[];
}

const IMAGES_PER_CHANNEL = 6;

const { entry, channels } = Astro.props;

const sections = channels.map((channel) => ({
  name: channel.data.name,
  channelUrl: channel.data.channelUrl,
  images: channel.data.blocks
    .flatMap((block) =>
      block.image
        ? [
            {
              image: block.image,
              alt: block.title ?? '',
              caption: block.title,
              href: block.sourceUrl ?? block.blockUrl,
            },
          ]
        : [],
    )
    .slice(0, IMAGES_PER_CHANNEL),
}));
---

<PageLayout entry={entry}>
  <main class="stack-section-gap mt-section-gap">
    {
      sections.map(({ name, channelUrl, images }) => (
        <section class={styles.channel}>
          <div class="row">
            <h2 class="heading-s sm:col-span-8">{name}</h2>
            <a class={cn(styles.link, 'sm:col-span-4')} href={channelUrl}>
              See all examples
            </a>
          </div>
          <Images
            type="images"
            variant="full"
            images={images}
            gradients
            className={styles.images}
          />
        </section>
      ))
    }
  </main>
</PageLayout>
