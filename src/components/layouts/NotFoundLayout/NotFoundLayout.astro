---
import cn from 'clsx';
import Layout from '@/components/layouts/Layout';

import styles from './NotFoundLayout.module.css';
---

<Layout title="404 Not Found">
  <div class={styles.root}>
    <div class={cn('row mt-section-gap', styles.numberRow)}>
      <div
        class="col-span-1 col-start-4 bg-primary"
        data-filled="solid"
        data-color-theme="theme-2"
      >
      </div>
      <div class="col-span-1 col-start-5 bg-primary" data-filled="solid"></div>
      <div class={cn('col-span-2 col-start-6', styles.firstRow, 'bg-primary')}>
      </div>
      <div
        class={cn(
          'col-span-1 col-start-7 bg-accent',
          styles.stackedTop,
          styles.firstRow,
        )}
      >
      </div>
      <div class="col-span-1 col-start-8 bg-primary" data-filled="solid"></div>
      <div class="col-span-1 col-start-9 bg-primary" data-filled="solid"></div>
    </div>
    <div class={cn('row', styles.numberRow)}>
      <div class="col-span-1 col-start-4 bg-primary" data-filled="solid"></div>
      <div class="col-span-1 col-start-5 bg-primary" data-filled="solid"></div>
      <div class={cn('col-span-1 col-start-6', styles.firstRow, 'bg-accent')}>
      </div>
      <div
        class={cn(
          'col-span-1 col-start-7 bg-accent',
          styles.stackedTop,
          styles.firstRow,
        )}
      >
      </div>
      <div class="col-span-1 col-start-8 bg-primary" data-filled="solid"></div>
      <div class="col-span-1 col-start-9 bg-primary" data-filled="solid"></div>
    </div>
    <div class={cn('row', styles.numberRow)}>
      <div
        class={cn(
          'col-span-1 col-start-4 bg-primary',
          styles.stackedTop,
          styles.firstRow,
        )}
      >
      </div>
      <div
        class={cn(
          'col-span-2 col-start-4 bg-accent',
          styles.firstRow,
          styles.stackedBelow,
        )}
      >
      </div>
      <div class="col-span-1 col-start-6 bg-accent" data-filled="solid"></div>
      <div class="col-span-1 col-start-7 bg-accent" data-filled="solid"></div>
      <div
        class={cn(
          'col-span-1 col-start-8 bg-primary',
          styles.stackedTop,
          styles.firstRow,
        )}
      >
      </div>
      <div
        class={cn(
          'col-span-2 col-start-8 bg-accent',
          styles.firstRow,
          styles.stackedBelow,
        )}
      >
      </div>
    </div>
    <div class={cn('row', styles.numberRow)}>
      <div class="col-span-1 col-start-5 bg-primary" data-filled="solid"></div>
      <div class="col-span-1 col-start-6 bg-accent" data-filled="solid"></div>
      <div class="col-span-1 col-start-7 bg-accent" data-filled="solid"></div>
      <div class="col-span-1 col-start-9 bg-primary" data-filled="solid"></div>
    </div>
    <div class={cn('row', styles.numberRow)}>
      <div class="col-span-1 col-start-5 bg-primary" data-filled="solid"></div>
      <div
        class={cn(
          'col-span-1 col-start-6 bg-accent',
          styles.firstRow,
          styles.stackedTop,
        )}
        data-filled="solid"
      >
      </div>
      <div
        class={cn(
          'col-span-2 col-start-6 bg-primary',
          styles.firstRow,
          styles.stackedBelow,
        )}
        data-filled="solid"
      >
      </div>
      <div class="col-span-1 col-start-9 bg-primary" data-filled="solid"></div>
    </div>
    <h1 class={cn('heading-m mt-4xl', styles.heading)}>Page not found</h1>
  </div>
</Layout>

<script>
  import type { ColorThemeName } from '@/lib/constants';
  let colorTheme: ColorThemeName = 'default';
  const themes: ColorThemeName[] = [
    'theme-2',
    'theme-3',
    'theme-4',
    'theme-5',
    'theme-6',
    'default',
  ];
  let index = 0;

  setInterval(() => {
    index = (index + 1) % themes.length;
    colorTheme = themes[index];
    document.documentElement.setAttribute('data-color-theme', colorTheme);
  }, 1000);
</script>
