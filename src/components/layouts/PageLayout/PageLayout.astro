---
import type { CollectionEntry } from 'astro:content';
import type { BlockProps } from '@/schemas/pages.ts';
import { blockComponents } from '@/components/blocks/index.ts';
import Layout from '@/components/layouts/Layout';

interface Props {
  entry: CollectionEntry<'pages'>;
  title?: string;
}

const { entry, title }: Props = Astro.props;
const page = entry.data;
---

<Layout
  title={title ?? page.title}
  colorTheme={page.colorTheme}
  threadSpan={page.threadSpan}
>
  {
    (page.blocks ?? []).map((block) => {
      const Block = blockComponents[block.type] as (
        props: BlockProps,
      ) => unknown;
      return Block ? <Block {...block} threadSpan={page.threadSpan} /> : null;
    })
  }
  <slot />
</Layout>
