---
import type { CollectionEntry } from 'astro:content';
import Blocks from './Blocks.astro';
import Layout from '@/components/layouts/Layout';

interface Props {
  entry: CollectionEntry<'pages'>;
  title?: string;
}

const { entry, title }: Props = Astro.props;
const page = entry.data;

const blocks = page.blocks ?? [];

// If there is a pageListing block, render slot at that position
// If none exists, render slot at the end of the document.
const marker = Astro.slots.has('default')
  ? blocks.findIndex((block) => block.type === 'pageListing')
  : -1;
const split = marker === -1 ? blocks.length : marker;
---

<Layout
  title={title ?? page.title}
  colorTheme={page.colorTheme}
  threadSpan={page.threadSpan}
>
  <Blocks blocks={blocks.slice(0, split)} threadSpan={page.threadSpan} />
  <slot />
  <Blocks blocks={blocks.slice(split + 1)} threadSpan={page.threadSpan} />
</Layout>
