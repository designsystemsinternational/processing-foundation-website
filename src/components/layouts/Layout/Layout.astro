---
import '@/styles/reset.css';
import '@/styles/variables.css';
import '@/styles/breakpoints.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/textStyles.css';
import '@/styles/utilities.css';

import type { ColorThemeName, ThreadSpan } from '@/lib/constants.ts';
import Footer from '@/components/composites/Footer';
import MainNavigation from '@/components/composites/MainNavigation';
import { getFooter } from '@/lib/footer.ts';
import { getNavigation } from '@/lib/navigation.ts';
import styles from './Layout.module.css';

type Props = {
  title: string;
  colorTheme?: ColorThemeName;
  threadSpan?: ThreadSpan;
};

const { title, colorTheme = 'default', threadSpan }: Props = Astro.props;
const mainNavigation = await getNavigation('main');
const footer = await getFooter();
---

<html
  lang="en"
  data-color-theme={colorTheme !== 'default' ? colorTheme : undefined}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          src="https://cdn.usefathom.com/script.js"
          data-site="VWFADXYB"
          defer
        />
      )
    }
  </head>
  <body>
    <div class={styles.root}>
      <MainNavigation items={mainNavigation} currentPath={Astro.url.pathname} />
      <slot />
      {footer && <Footer {...footer} threadSpan={threadSpan} />}
    </div>
  </body>
</html>
