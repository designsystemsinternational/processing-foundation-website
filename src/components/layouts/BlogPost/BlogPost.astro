---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import cn from 'clsx';
import Layout from '@/components/layouts/Layout';
import RelatedBlogPosts from '@/components/composites/RelatedBlogPosts';
import Tag from '@/components/primitives/Tag';
import { readingTime } from '@/lib/utils.ts';
import styles from './BlogPost.module.css';

interface Props {
  entry: CollectionEntry<'blogPosts'>;
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);
const captionHtml = post.headerImageCaption
  ? await marked.parseInline(post.headerImageCaption)
  : null;

const readTime = readingTime(entry.body ?? '');

// post.category stores the category's name, so the slug for its link has to
// come from the blogCategories entry.
const category = post.category
  ? (await getCollection('blogCategories')).find(
      (entry) => entry.data.name === post.category,
    )
  : undefined;
---

<Layout title={post.title}>
  <article class="container layout-grid gap-internal-section-gap">
    <header class="layout-grid gap-l">
      <div class="row">
        <div class="lg:col-span-6">
          <h1 class="heading-l">{post.title}</h1>
        </div>
      </div>
      <div class="row">
        {
          post.subtitle && (
            <div class="lg:col-span-6 text-secondary body-l">
              <h2>{post.subtitle}</h2>
            </div>
          )
        }
        <div class="lg:col-span-6">
          {
            category && (
              <Tag
                label={category.data.name}
                href={`/blog/category/${category.data.slug ?? category.id}`}
              />
            )
          }
        </div>
      </div>
    </header>
    {
      post.headerImage && (
        <div class="row">
          <div class="col-span-12">
            <figure>
              <Image
                src={post.headerImage}
                alt=""
                widths={[400, 800, post.headerImage.width]}
                sizes="(max-width: 800px) 100vw, 800px"
              />
              {captionHtml && <figcaption set:html={captionHtml} />}
            </figure>
          </div>
        </div>
      )
    }

    <div class="row">
      <div class="lg:col-span-3 body-m text-secondary">
        <div>By {post.author.join(', ')}</div>
        <div>
          {
            post.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </div>
      </div>
      <div class={cn('lg:col-span-6', styles.content)}>
        <Content />
      </div>
      <div class={cn('col-span-3', styles.readTime)}>
        {readTime} min read
      </div>
    </div>
  </article>
  <RelatedBlogPosts category={post.category} excludeId={entry.id} />
</Layout>
