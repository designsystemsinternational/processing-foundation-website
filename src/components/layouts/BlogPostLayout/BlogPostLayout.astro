---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Image from '@/components/primitives/Image';
import cn from 'clsx';
import Layout from '@/components/layouts/Layout';
import RelatedBlogPosts from '@/components/composites/RelatedBlogPosts';
import Divider from '@/components/primitives/Divider';
import Tag from '@/components/primitives/Tag';
import { getRoutedPage } from '@/lib/pages';
import {
  readingTime,
  dateLabel,
  dateIso,
  readTimeDatetime,
  readTimeLabel,
} from '@/lib/utils.ts';
import styles from './BlogPostLayout.module.css';

interface Props {
  entry: CollectionEntry<'blogPosts'>;
}

const { entry }: Props = Astro.props;
const post = entry.data;
const { Content } = await render(entry);
const readTime = readingTime(entry.body ?? '');
const category = post.category
  ? (await getCollection('blogCategories')).find(
      (entry) => entry.data.name === post.category,
    )
  : undefined;
const indexEntry = await getRoutedPage('blog');
const { threadSpan, colorTheme } = indexEntry.data;
---

<Layout title={post.title} colorTheme={colorTheme} threadSpan={threadSpan}>
  <article>
    <header class="container layout-grid gap-l mt-internal-section-gap">
      <div class="row">
        <div class="lg:col-span-8">
          <h1 class="heading-xl">{post.title}</h1>
        </div>
      </div>
      <div class="row mb-internal-section-gap">
        {
          post.subtitle && (
            <div class="lg:col-span-6 text-secondary body-m">
              <h2>{post.subtitle}</h2>
            </div>
          )
        }
        <div class="lg:col-span-6">
          {
            category && (
              <Tag
                label={category.data.name}
                href={`/blog/category/${category.data.slug ?? category.id}`}
              />
            )
          }
        </div>
      </div>
    </header>
    {
      post.headerImage && (
        <>
          <Divider className="mb-l" threadSpan={threadSpan} />
          <div class="row">
            <Image
              src={post.headerImage}
              alt=""
              widths={[640, 1080, 1600, 2400, 3104]}
              sizes="(max-width: 1600px) 100vw, 1552px"
              caption={post.headerImageCaption}
              className="mb-l"
            />
          </div>
        </>
      )
    }
    <Divider className="mb-internal-section-gap" threadSpan={threadSpan} />
    <div class="row">
      <div class="lg:col-span-3 body-m text-secondary">
        <div class="mb-s">By {post.author.join(', ')}</div>
        <div class="body-xs">
          <time datetime={dateIso(post.date)}>{dateLabel(post.date)}</time>
        </div>
        <div class="body-xs">
          <time datetime={readTimeDatetime(readTime)}>
            {readTimeLabel(readTime)}
          </time>
        </div>
      </div>
      <div class={cn('lg:col-span-6', styles.content)}>
        <Content />
      </div>
      <div class="col-span-3"></div>
    </div>
  </article>
  <RelatedBlogPosts category={post.category} excludeId={entry.id} />
</Layout>
