---
import type { GetStaticPaths } from 'astro';
import FellowshipGrid from '@/components/composites/FellowshipGrid';
import PageLayout from '@/components/layouts/PageLayout';
import { fellowshipYears, getSortedFellowships } from '@/lib/fellowships.ts';
import { getRoutedPage } from '@/lib/pages.ts';
import { paginationUrls } from '@/lib/pagination.ts';
import RelatedBlogPosts from '@/components/blocks/RelatedBlogPosts';

export const getStaticPaths = (async ({ paginate }) => {
  const fellowships = await getSortedFellowships();
  return paginate(fellowships, {
    pageSize: 16,
    props: { years: fellowshipYears(fellowships) },
  });
}) satisfies GetStaticPaths;

const { page, years } = Astro.props;

const entry = await getRoutedPage('fellowships');

const pageUrls = paginationUrls(
  '/programs/fellowships',
  page.lastPage,
  '#fellowship-grid',
);

const title =
  page.currentPage > 1
    ? `${entry.data.title} — Page ${page.currentPage}`
    : undefined;
---

<PageLayout entry={entry} title={title}>
  <FellowshipGrid page={page} pageUrls={pageUrls} years={years} />
  <RelatedBlogPosts category="Fellowships" />
</PageLayout>
