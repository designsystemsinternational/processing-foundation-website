---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import PageHero from '@/components/blocks/PageHero';
import Layout from '@/components/layouts/Layout';
import { renderMarkdown } from '@/lib/html.ts';
import { getPage } from '@/lib/pages.ts';
import { imageIfSet } from '@/lib/utils.ts';

export const getStaticPaths = (async () => {
  const projects = await getCollection('grantProjects');
  const people = await getCollection('people');
  const personNamed = (name: string) =>
    people.find((person) => person.data.name === name);

  return projects.map((entry) => {
    // The id is the entry's "<grant>/<year>/<slug>" directory; see content.config.ts.
    const [grant, year, slug] = entry.id.split('/');
    const grantees = entry.data.grantees.flatMap(
      (name) => personNamed(name) ?? [],
    );
    return {
      params: { grant, year, slug },
      props: { entry, grantees },
    };
  });
}) satisfies GetStaticPaths;

const { entry, grantees } = Astro.props;
const project = entry.data;
const granteeNames = project.grantees.join(', ');

const grant = await getEntry('grants', project.grant);
const grantName = grant?.data.title ?? project.grant;

const section = await getPage('programs/grants');
const { colorTheme, threadSpan } = section.data;

const portrait = imageIfSet(grantees[0]?.data.image);
const bios = grantees.map((person) => person.body ?? '').filter(Boolean);
const text = [...bios, entry.body ?? ''].filter(Boolean).join('\n\n');
---

<Layout title={granteeNames} colorTheme={colorTheme}>
  <PageHero
    threadSpan={threadSpan}
    eyebrow={`Programs / Grants / ${grantName} / ${project.year}`}
    title={granteeNames}
    subtitle={project.title}
    text={renderMarkdown(text)}
    variant="default"
    media={imageIfSet(project.image) ?? portrait}
  />
</Layout>
