---
import PageLayout from "@/components/layouts/PageLayout";
import BlogPostLayout from "@/components/layouts/BlogPostLayout";
import { parsePreviewPayload, type PreviewEntry } from "@/lib/cms/preview.ts";

export const prerender = false;

const site = Astro.request.headers.get("sec-fetch-site");
const isSameOrigin = site === null || site === "same-origin" || site === "same-site";

if (Astro.request.method !== "POST") {
  return new Response("Method Not Allowed", { status: 405 });
}

if (!isSameOrigin) {
  return new Response("Forbidden", { status: 403 });
}

let preview: PreviewEntry | null = null;
let error: string | null = null;

try {
  preview = await parsePreviewPayload(await Astro.request.json());
} catch {
  error = "Could not parse preview payload.";
}
---

{
  error || !preview ? (
    <html lang="en">
      <body>
        <p>{error ?? "No preview data."}</p>
      </body>
    </html>
  ) : preview.collection === "blog-posts" ? (
    <BlogPostLayout entry={preview.entry} />
  ) : (
    <PageLayout entry={preview.entry} />
  )
}
