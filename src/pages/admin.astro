---
const reactRefreshPreamble = import.meta.env.DEV
  ? `
      import RefreshRuntime from '/@react-refresh'
      RefreshRuntime.injectIntoGlobalHook(window)
      window.$RefreshReg$ = () => {}
      window.$RefreshSig$ = () => (type) => type
      window.__vite_plugin_react_preamble_installed__ = true
    `
  : "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link href="/config.yml" type="text/yaml" rel="cms-config-url" />
    <title>Content Manager</title>
    <script type="module" is:inline set:html={reactRefreshPreamble} />
  </head>
  <body>
    <script>
      import CMS from "decap-cms-app";
      import { createElement as h, useEffect, useRef, useState } from "react";
      import { slugify } from "@/lib/utils";
      import {
        collectMediaPaths,
        inlinePreviewAssets,
        mediaFileName,
        normalizeMediaPath,
        type PreviewAsset,
      } from "@/lib/cms/assets.ts";
      import { MetaPathPreview } from "@/lib/cms/widgets/util.tsx";
      import { FellowshipPathControl } from "@/lib/cms/widgets/FellowshipPathWidget/FellowshipPathWidget.tsx";
      import { PagePathControl } from "@/lib/cms/widgets/PagePathWidget/PagePathWidget.tsx";

      const DEBOUNCE_MS = 300;

      type GetAsset = (path: string) => { toString(): string } | undefined;

      interface Entry {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        getIn(path: string[]): any;
      }

      interface MediaFile {
        path: string;
        url?: string;
        draft?: boolean;
      }

      interface PreviewProps {
        entry: Entry;
        getAsset: GetAsset;
      }

      type Size = { width: number; height: number };

      const sizes = new Map<string, Size>();

      function measure(url: string): Promise<Size | null> {
        return new Promise((resolve) => {
          const image = new window.Image();
          image.onload = () =>
            resolve({ width: image.naturalWidth, height: image.naturalHeight });
          image.onerror = () => resolve(null);
          image.src = url;
        });
      }

      // An uploaded file stays an in-memory blob until the entry is saved, so
      // only Decap can resolve its path to something loadable. Its own
      // `getAsset` misses those blobs — the media store keys a file by a path
      // with no leading slash, and our public_folder gives every field value
      // one — but the entry's own mediaFiles list carries them. Take a blob
      // from a draft file only: the one Decap makes for a file already in the
      // repo dies with the media library, while getAsset returns that file's
      // real path, which the dev server serves.
      //
      // Astro needs real dimensions too, and the browser is the one place they
      // can be read, so measure each URL once and cache it.
      function usePreviewAssets(data: unknown, entry: Entry, getAsset: GetAsset) {
        const [, setResolved] = useState(0);
        const drafts: MediaFile[] = (
          entry.getIn(["mediaFiles"])?.toJS?.() ?? []
        ).filter((media: MediaFile) => media.draft && media.url);
        const urls = [...collectMediaPaths(data)].map((path) => {
          const draft =
            drafts.find(
              (media) => normalizeMediaPath(media.path) === normalizeMediaPath(path),
            ) ??
            drafts.find((media) => mediaFileName(media.path) === mediaFileName(path));
          return [path, draft?.url ?? String(getAsset(path) ?? "")] as const;
        });
        const key = urls.map(([path, url]) => `${path}:${url}`).join("|");

        useEffect(() => {
          const pending = urls
            .map(([, url]) => url)
            .filter((url) => url && !sizes.has(url));
          if (!pending.length) return;
          let live = true;
          Promise.all(
            // Cache what loads only: a path that fails now becomes loadable
            // once its entry is saved.
            pending.map(async (url) => {
              const size = await measure(url);
              if (size) sizes.set(url, size);
            }),
          ).then(() => live && setResolved((count) => count + 1));
          return () => {
            live = false;
          };
        }, [key]);

        // A size only matters to an image field, which needs one to render at
        // the right shape. A markdown image is happy with the URL alone.
        return Object.fromEntries(
          urls.flatMap(([path, url]) =>
            url
              ? [[path, { path, url, ...sizes.get(url) } satisfies PreviewAsset]]
              : [],
          ),
        );
      }

      // Renders an entry by POSTing its data to /preview, which hands it to the
      // same component the real page uses (see src/components/pages/).
      function makePreview(collection: string) {
        return function Preview({ entry, getAsset }: PreviewProps) {
          const [html, setHtml] = useState("");
          const data = entry.getIn(["data"])?.toJS?.() ?? {};
          const assets = usePreviewAssets(data, entry, getAsset);
          const payload = JSON.stringify({ collection, data, assets });
          const frame = useRef<HTMLIFrameElement>(null);

          useEffect(() => {
            const controller = new AbortController();
            const timer = setTimeout(() => {
              fetch("/preview", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: payload,
                signal: controller.signal,
              })
                .then((res) => res.text())
                .then((markup) => setHtml(inlinePreviewAssets(markup)))
                .catch((err) => {
                  if (err.name !== "AbortError")
                    setHtml(`<pre>${String(err)}</pre>`);
                });
            }, DEBOUNCE_MS);
            return () => {
              clearTimeout(timer);
              controller.abort();
            };
          }, [payload]);

          return h("iframe", {
            ref: frame,
            srcDoc: html,
            title: "Preview",
            style: {
              position: "fixed",
              inset: 0,
              width: "100%",
              height: "100%",
              border: "none",
            },
          });
        };
      }

      CMS.registerPreviewTemplate("pages", makePreview("pages"));
      CMS.registerPreviewTemplate("blog-posts", makePreview("blog-posts"));

      // Collections whose "slug" field defaults to a slugified version of
      // another field on save, unless the editor already typed a custom
      // value into it.
      const SLUG_SOURCE_FIELD: Record<string, string> = {
        "blog-posts": "title",
        "blog-categories": "name",
      };

      CMS.registerEventListener({
        name: "preSave",
        handler: ({ entry }) => {
          const data = entry.get("data");
          const sourceField = SLUG_SOURCE_FIELD[entry.get("collection")];
          if (!sourceField || data.get("slug")) {
            return data;
          }
          return data.set("slug", slugify(data.get(sourceField) ?? ""));
        },
      });

      CMS.registerWidget("page-path", PagePathControl, MetaPathPreview);
      CMS.registerWidget(
        "fellowship-path",
        FellowshipPathControl,
        MetaPathPreview,
      );
      CMS.init();
    </script>
  </body>
</html>
