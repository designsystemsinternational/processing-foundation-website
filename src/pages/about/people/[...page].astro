---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout';
import PeopleGrid from '@/components/composites/PeopleGrid';
import { personRoles, routedPages } from '@/lib/constants.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const rolePriority = (roles: (typeof personRoles)[number][]) =>
    Math.min(...roles.map((role) => personRoles.indexOf(role)));

  const people = (await getCollection('people')).sort((a, b) => {
    const roleDiff = rolePriority(a.data.roles) - rolePriority(b.data.roles);
    return roleDiff !== 0 ? roleDiff : a.data.name.localeCompare(b.data.name);
  });
  return paginate(people, { pageSize: 36 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const entry = await getEntry('pages', routedPages.people);
if (!entry) {
  throw new Error(
    `/about/people needs its page content at src/content/pages/${routedPages.people}.json. Restore the entry, or delete this route.`,
  );
}

const pageUrls = Object.fromEntries(
  Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNumber) => [
    pageNumber,
    (pageNumber === 1 ? '/about/people' : `/about/people/${pageNumber}`) +
      '#people-grid',
  ]),
);
---

<PageLayout entry={entry}>
  <PeopleGrid page={page} pageUrls={pageUrls} />
</PageLayout>
