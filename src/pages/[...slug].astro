---
import { getCollection } from "astro:content";
import PageLayout from "@/components/layouts/PageLayout";
import { routedPages } from "@/lib/constants.ts";

export async function getStaticPaths() {
  const routed = Object.values(routedPages) as string[];
  const pages = await getCollection(
    "pages",
    (page) => !routed.includes(page.id),
  );
  return pages.map((page) => ({
    // An undefined rest param is "/", which is where the `index` entry belongs.
    params: { slug: page.id === "index" ? undefined : page.id },
    props: { entry: page },
  }));
}

const { entry } = Astro.props;
---

<PageLayout entry={entry} />
