---
import { getCollection } from "astro:content";
import Layout from "@/components/layouts/Layout";
import TagsNavigation from "@/components/composites/TagsNavigation";
import { blogCategorySlug, slugify } from "@/lib/utils.ts";

const posts = (await getCollection("blogPosts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// blogPosts.category stores the category's *name* (see blogPosts.ts), but
// TagsNavigation links by slug, so posts need the same slug to match against.
const categorySlugByName = new Map(
  (await getCollection("blogCategories")).map((category) => [
    category.data.name,
    blogCategorySlug(category.data),
  ]),
);
---

<Layout title="Blog">
  <main>
    <h1>Blog</h1>
    <TagsNavigation target="[data-blog-posts]" />
    <ul data-blog-posts>
      {
        posts.map((post) => {
          const slug = post.data.slug || slugify(post.data.title);
          const categorySlug = post.data.category
            ? (categorySlugByName.get(post.data.category) ??
              slugify(post.data.category))
            : "";
          return (
            <li data-category={categorySlug}>
              <a href={`/blog/${slug}`}>
                <h2>{post.data.title}</h2>
                {post.data.subtitle && <p>{post.data.subtitle}</p>}
                <p>
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                  {" · "}
                  {post.data.author.join(", ")}
                  {post.data.category && ` · ${post.data.category}`}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>


<style>
  ul {
    padding-left: 1.5rem;
    list-style: disc;
  }

  li a {
    display: block;
  }

  [data-blog-posts][data-category-transitioning] {
    transition: opacity 150ms ease;
    opacity: 0.4;
  }
</style>
