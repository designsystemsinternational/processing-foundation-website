---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/components/layouts/Layout";
import TagsNavigation from "@/components/composites/TagsNavigation";
import { slugify } from "@/lib/utils.ts";

const THUMBNAIL_SIZE = 200;

const posts = (await getCollection("blogPosts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

---

<Layout title="Blog">
  <main>
    <h1>Blog</h1>
    <TagsNavigation/>
    <ul data-blog-posts>
      {
        posts.map((post) => {
          const slug = post.data.slug || slugify(post.data.title);
          return (
            <li>
              <a href={`/blog/${slug}`}>
                {post.data.headerImage && (
                  <Image
                    src={post.data.headerImage}
                    alt=""
                    width={THUMBNAIL_SIZE}
                    height={THUMBNAIL_SIZE}
                    fit="cover"
                    position={post.data.headerImagePosition}
                  />
                )}
                <div>
                  <h2>{post.data.title}</h2>
                  {post.data.subtitle && <p>{post.data.subtitle}</p>}
                  <p>
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                    {" · "}
                    {post.data.author.join(", ")}
                    {post.data.category && ` · ${post.data.category}`}
                  </p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>


<style>
  ul {
    padding-left: 1.5rem;
    list-style: disc;
  }

  li a {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

</style>
