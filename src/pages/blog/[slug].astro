---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { slugify } from "../../lib/utils.ts";
import { marked } from "marked";

export async function getStaticPaths() {
  const posts = await getCollection("blogPosts");
  return posts.map((post) => ({
    params: { slug: post.data.slug || slugify(post.data.title) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const captionHtml = post.data.headerImageCaption
  ? await marked.parseInline(post.data.headerImageCaption)
  : null;
---

<Layout title={post.data.title}>
  <article >
    <h1 class="heading-l">{post.data.title}</h1>
    {post.data.subtitle && <p >{post.data.subtitle}</p>}
    {
      post.data.headerImage && (
        <figure>
          <Image
            src={post.data.headerImage}
            alt=""
            widths={[400, 800, post.data.headerImage.width]}
            sizes="(max-width: 800px) 100vw, 800px"
          />
          {captionHtml && <figcaption set:html={captionHtml} />}
        </figure>
      )
    }
    <p>
      {
        post.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
      {" · "}
      {post.data.author.join(", ")}
      {post.data.category && ` · ${post.data.category}`}
    </p>
    <div>
      <Content />
    </div>
  </article>
</Layout>
