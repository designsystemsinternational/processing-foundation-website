---
import { getCollection } from 'astro:content';
import PersonHeader from '@/components/blocks/PersonHeader';
import RelatedBlogPosts from '@/components/blocks/RelatedBlogPosts';
import Layout from '@/components/layouts/Layout';
import { renderMarkdown } from '@/lib/html.ts';
import { getRoutedPage } from '@/lib/pages';
import { imageIfSet } from '@/lib/utils.ts';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const entry = await getRoutedPage('people');

const { person } = Astro.props;
const { name, title, url, employmentStatus, roles } = person.data;
const portrait = imageIfSet(person.data.image);

const [firstName] = name.split(' ');
---

<Layout title={name} colorTheme={entry.data.colorTheme}>
  <PersonHeader
    eyebrow={`ABOUT / PEOPLE / ${name}`}
    name={name}
    title={title}
    body={renderMarkdown(person.body ?? '')}
    url={url}
    roles={roles}
    employmentStatus={employmentStatus}
    image={portrait}
    threadSpan={entry.data.threadSpan}
  />
  <RelatedBlogPosts
    author={name}
    title={`Blog posts by ${firstName}`}
    showSeeAllLink={false}
    spacing="3xl"
  />
</Layout>
